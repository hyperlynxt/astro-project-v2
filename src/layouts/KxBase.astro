---
import '../styles/global.css';

interface Props {
  title: string;
  crumb: string;
  maxWidth?: 'narrow' | 'wide';
}

const { title, crumb, maxWidth = 'wide' } = Astro.props;
const wrapMax = maxWidth === 'narrow' ? '780px' : '1040px';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · kx</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Reenie+Beanie&display=swap" rel="stylesheet">
    <style define:vars={{ wrapMax }}>
        :root {
            --bg: #FCFAF5; --ink: #23211d; --ink-soft: #55503f; --ink-faint: #8c8070;
            --line: #ddd4bf; --teal: #2A4747; --gold: #B08D57; --seal: #8B2626;
            --panel: #F5F1E6; --panel-2: #EFE9D9;
        }
        :root[data-theme="dark"] {
            --bg: #1a1815; --ink: #ece7db; --ink-soft: #b8b0a0; --ink-faint: #7a7266;
            --line: #3a352d; --teal: #6fa89f; --gold: #d4a86a; --seal: #d16b6b;
            --panel: #232019; --panel-2: #1f1c17;
        }
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --bg: #1a1815; --ink: #ece7db; --ink-soft: #b8b0a0; --ink-faint: #7a7266;
                --line: #3a352d; --teal: #6fa89f; --gold: #d4a86a; --seal: #d16b6b;
                --panel: #232019; --panel-2: #1f1c17;
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background-color: var(--bg);
            background-image: url("https://www.transparenttextures.com/patterns/natural-paper.png"), url("https://www.transparenttextures.com/patterns/natural-paper.png");
            background-position: 0px 0px, 40px 60px;
            background-repeat: repeat;
            color: var(--ink);
            font-family: "EB Garamond", serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .topbar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 1.1rem 2rem; border-bottom: 1px solid var(--line);
        }
        .brand {
            display: flex; align-items: baseline; gap: 0.6rem; text-decoration: none;
            font-family: "Reenie Beanie", cursive; font-size: 1.6rem; color: var(--ink);
        }
        .brand small { font-family: "Inter", sans-serif; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
        .crumbs { font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
        .crumbs a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--line); }
        .crumbs a:hover { color: var(--teal); border-color: var(--teal); }
        .crumbs .current { color: var(--ink); }

        .wrap { max-width: var(--wrapMax); margin: 0 auto; padding: 0 1.5rem; }

        .section-head {
            display: flex; align-items: baseline; justify-content: space-between;
            gap: 1rem; margin: 3.5rem 0 1.2rem;
        }
        .section-head h2 { font-size: 1.4rem; font-weight: 500; margin: 0; }
        .section-head .num {
            font-family: "JetBrains Mono", monospace; font-size: 0.7rem;
            color: var(--gold); letter-spacing: 0.05em; white-space: nowrap;
        }
        .section-note {
            font-family: "Inter", sans-serif; font-size: 0.82rem; color: var(--ink-soft);
            margin: -0.7rem 0 1.4rem; max-width: 64ch; line-height: 1.55;
        }

        .footnav {
            margin: 5rem 0 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem;
            font-family: "Inter", sans-serif; font-size: 0.8rem; color: var(--ink-faint);
        }
        .footnav a { text-decoration: none; color: var(--ink-soft); }
        .footnav a:hover { color: var(--teal); }
    </style>
    <slot name="head" />
</head>
<body>
    <div class="topbar">
        <a href="/astro-project-v2/kx/" class="brand">& <small>kx system</small></a>
        <nav class="crumbs">
            <a href="/astro-project-v2/">interlynkx</a> / <a href="/astro-project-v2/kx/">kx</a> / <span class="current">{crumb}</span>
        </nav>
    </div>

    <div class="wrap">
        <slot />

        <div class="footnav">
            <a href="/astro-project-v2/kx/">&larr; volver al hub</a>
            <span>dibujado el {new Date().toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}</span>
        </div>
    </div>
</body>
</html>
