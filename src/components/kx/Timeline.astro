---
// Timeline: eje vertical con marcas por fecha y tarjetas a un lado.
// Slot-based: cada hijo es una entrada, ya renderizada por quien la use
// (sesiones, ciclos, log tienen forma de contenido distinta).
interface Props {
  vacio?: string;
  tieneItems: boolean;
}
const { vacio = 'Todavía no hay nada acá.', tieneItems } = Astro.props;
---

{tieneItems ? (
  <div class="kx-timeline">
    <slot />
  </div>
) : (
  <p class="kx-vacio">{vacio}</p>
)}

<style>
  .kx-timeline { position: relative; display: flex; flex-direction: column; gap: 0; padding-left: 1.6rem; }
  .kx-timeline::before {
    content: ''; position: absolute; left: 5px; top: 6px; bottom: 6px; width: 2px;
    background: var(--kx-line);
  }
  .kx-vacio {
    font-family: var(--kx-font-sans); font-size: 0.85rem; color: var(--kx-ink-soft); line-height: 1.55;
    background: var(--kx-panel); border: 1px dashed var(--kx-line); border-radius: var(--kx-radius);
    padding: 1.1rem 1.3rem; margin: 0;
  }
</style>
