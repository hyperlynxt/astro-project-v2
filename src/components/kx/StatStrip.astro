---
interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stats">
    {stats.map((s) => (
        <div class="stat">
            <b>{s.value}</b>
            <span>{s.label}</span>
        </div>
    ))}
</div>

<style>
    .stats {
        display: grid; grid-template-columns: repeat(5, 1fr);
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 2.2rem 0 2rem;
    }
    @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } .stat { border-top: 1px solid var(--line); } .stat:nth-child(1), .stat:nth-child(2) { border-top: none; } }
    .stat { padding: 1.2rem 1rem; text-align: center; border-left: 1px solid var(--line); }
    .stat:first-child { border-left: none; }
    @media (max-width: 700px) { .stat:nth-child(odd) { border-left: none; } }
    .stat b { display: block; font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 600; color: var(--teal); line-height: 1; margin-bottom: 0.35rem; }
    .stat span { font-family: "Inter", sans-serif; font-size: 0.66rem; letter-spacing: 0.04em; color: var(--ink-soft); line-height: 1.3; display: block; }
</style>
