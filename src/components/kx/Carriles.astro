---
// Carriles: cursograma con un carril por actor, pasos numerados en secuencia.
// Para /kx/atlas/flujos/{id}/, esperando a que kx-workflows tenga datos (KX-T22).
interface Actor { key: string; label: string; colorVar: string }
interface Paso { numero: number; actor: string; texto: string; cuelloDeBotella?: boolean }
interface Props {
  actores: Actor[];
  pasos: Paso[];
}
const { actores, pasos } = Astro.props;
---

<div class="kx-carriles">
  {actores.map((actor) => {
    const pasosDelActor = pasos.filter((p) => p.actor === actor.key);
    if (!pasosDelActor.length) return null;
    return (
      <div class="kx-carril">
        <div class="kx-carril-label" style={`--acolor: var(${actor.colorVar})`}>
          <span class="kx-dot"></span>{actor.label}
        </div>
        <div class="kx-carril-pasos">
          {pasosDelActor.map((p) => (
            <div class={`kx-paso ${p.cuelloDeBotella ? 'is-cuello' : ''}`} style={`--acolor: var(${actor.colorVar})`}>
              <span class="kx-paso-num">{p.numero}</span>
              <span class="kx-paso-texto">{p.texto}</span>
              {p.cuelloDeBotella && <span class="kx-paso-tag">cuello de botella</span>}
            </div>
          ))}
        </div>
      </div>
    );
  })}
</div>

<style>
  .kx-carriles {
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg);
    padding: 1.3rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;
    box-shadow: 0 2px 10px var(--kx-shadow);
  }
  .kx-carril { display: grid; grid-template-columns: 140px 1fr; gap: 1rem; align-items: start; }
  .kx-carril-label {
    display: flex; align-items: center; gap: 0.5rem; font-family: var(--kx-font-sans);
    font-size: 0.78rem; font-weight: 700; color: var(--acolor); padding-top: 0.4rem;
  }
  .kx-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--acolor); flex-shrink: 0; }
  .kx-carril-pasos { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .kx-paso {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.9rem;
    background: color-mix(in srgb, var(--acolor) 12%, var(--kx-panel));
    border: 1px solid color-mix(in srgb, var(--acolor) 35%, transparent);
    border-radius: var(--kx-radius); font-family: var(--kx-font-sans); font-size: 0.78rem;
  }
  .kx-paso.is-cuello { border-style: dashed; border-color: var(--kx-alert); }
  .kx-paso-num {
    font-family: var(--kx-font-mono); font-size: 0.68rem; font-weight: 700;
    color: var(--acolor); flex-shrink: 0;
  }
  .kx-paso-tag {
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase; color: var(--kx-alert);
    background: var(--kx-alert-tint); padding: 0.15rem 0.4rem; border-radius: 6px;
  }
</style>
