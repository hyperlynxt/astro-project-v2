---
// Medidor: conteo grande + desglose por estado (o cualquier rampa) en una barra apilada.
import { RAMPAS, type Rampa } from '../../lib/kx';

interface Segmento { estado: string; count: number }
interface Props {
  valor: number;
  label: string;
  desglose?: Segmento[];
  rampa?: Rampa;
}
const { valor, label, desglose = [], rampa = 'estado' } = Astro.props;
const meta = RAMPAS[rampa];
const total = desglose.reduce((s, d) => s + d.count, 0) || 1;
---

<div class="kx-medidor">
  <div class="kx-medidor-top">
    <span class="kx-medidor-valor">{valor}</span>
    <span class="kx-medidor-label">{label}</span>
  </div>
  {desglose.length > 0 && (
    <>
      <div class="kx-medidor-bar">
        {desglose.filter((d) => d.count > 0).map((d) => (
          <span
            class="kx-medidor-seg"
            style={`width: ${(d.count / total) * 100}%; background: var(${meta[d.estado]?.var ?? '--kx-slate'})`}
            title={`${d.estado}: ${d.count}`}
          ></span>
        ))}
      </div>
      <div class="kx-medidor-legend">
        {desglose.filter((d) => d.count > 0).map((d) => (
          <span class="kx-medidor-legend-item">
            <span class="kx-dot" style={`background: var(${meta[d.estado]?.var ?? '--kx-slate'})`}></span>
            {meta[d.estado]?.label ?? d.estado} <b>{d.count}</b>
          </span>
        ))}
      </div>
    </>
  )}
</div>

<style>
  .kx-medidor {
    background: var(--kx-paper); border: 1px solid var(--kx-line);
    border-radius: var(--kx-radius-lg); padding: 1.4rem 1.6rem;
    box-shadow: 0 2px 10px var(--kx-shadow);
  }
  .kx-medidor-top { display: flex; align-items: baseline; gap: 0.7rem; margin-bottom: 0.9rem; }
  .kx-medidor-valor {
    font-family: var(--kx-font-serif); font-size: clamp(2.1rem, 4vw, 2.7rem);
    font-weight: 600; color: var(--kx-accent-deep); line-height: 1;
  }
  .kx-medidor-label {
    font-family: var(--kx-font-sans); font-size: 0.78rem; font-weight: 600;
    color: var(--kx-ink-soft);
  }
  .kx-medidor-bar {
    display: flex; width: 100%; height: 8px; border-radius: var(--kx-radius-pill);
    overflow: hidden; background: var(--kx-line-soft); gap: 1.5px;
  }
  .kx-medidor-seg { display: block; height: 100%; min-width: 3px; }
  .kx-medidor-legend {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; margin-top: 0.75rem;
    font-family: var(--kx-font-sans); font-size: 0.7rem; color: var(--kx-ink-soft);
  }
  .kx-medidor-legend-item { display: inline-flex; align-items: center; gap: 0.35rem; }
  .kx-medidor-legend-item b { color: var(--kx-ink); font-weight: 700; }
  .kx-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
</style>
