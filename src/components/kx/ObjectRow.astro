---
import EstadoChip from './EstadoChip.astro';
import { fechaCorta } from '../../lib/kx';

interface Props {
  titulo: string;
  tipo?: string;
  estado?: string;
  fecha?: Date;
  href?: string;
}

const { titulo, tipo, estado, fecha, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="object-row" href={href}>
    <div class="left">
        <span class="titulo">{titulo}</span>
        {tipo && <span class="tipo">{tipo}</span>}
    </div>
    <div class="right">
        {fecha && <span class="fecha">{fechaCorta(fecha)}</span>}
        {estado && <EstadoChip estado={estado} />}
    </div>
</Tag>

<style>
    .object-row {
        display: flex; align-items: center; justify-content: space-between; gap: 0.8rem;
        padding: 0.65rem 0; border-top: 1px solid var(--line);
        text-decoration: none; color: var(--ink);
    }
    a.object-row:hover .titulo { color: var(--teal); }
    .object-row:first-child { border-top: none; }
    .left { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
    .titulo { font-family: "Inter", sans-serif; font-weight: 600; font-size: 0.86rem; }
    .tipo { font-family: "Inter", sans-serif; font-size: 0.68rem; color: var(--ink-faint); flex-shrink: 0; }
    .right { display: flex; align-items: center; gap: 0.7rem; flex-shrink: 0; }
    .fecha { font-family: "JetBrains Mono", monospace; font-size: 0.66rem; color: var(--ink-faint); }
</style>
