---
// TarjetaObjeto: id mono, título, pastillas, descripción truncada, fecha. Enlaza a la ficha.
import Pastilla from './Pastilla.astro';
import { fechaCorta, type Rampa } from '../../lib/kx';

interface Props {
  href?: string;
  id?: string;
  titulo: string;
  descripcion?: string;
  fecha?: Date;
  pastillas?: { rampa: Rampa; valor: string }[];
}
const { href, id, titulo, descripcion, fecha, pastillas = [] } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="kx-tarjeta" href={href}>
  <div class="kx-tarjeta-head">
    {id && <span class="kx-tarjeta-id">{id}</span>}
    <div class="kx-tarjeta-pastillas">
      {pastillas.map((p) => <Pastilla rampa={p.rampa} valor={p.valor} size="sm" />)}
    </div>
  </div>
  <h3 class="kx-tarjeta-titulo">{titulo}</h3>
  {descripcion && <p class="kx-tarjeta-desc">{descripcion}</p>}
  {fecha && <span class="kx-tarjeta-fecha">{fechaCorta(fecha)}</span>}
</Tag>

<style>
  .kx-tarjeta {
    display: block; text-decoration: none; color: var(--kx-ink);
    background: var(--kx-paper); border: 1px solid var(--kx-line);
    border-radius: var(--kx-radius); padding: 1.15rem 1.3rem;
    box-shadow: 0 2px 10px var(--kx-shadow);
    transition: transform 0.2s cubic-bezier(0.22,1,0.36,1), border-color 0.2s ease, box-shadow 0.25s ease;
  }
  a.kx-tarjeta:hover {
    transform: translateY(-3px);
    border-color: var(--kx-accent-mid);
    box-shadow: 0 0 0 1px var(--kx-accent-mid), 0 16px 30px -16px var(--kx-accent-glow);
  }
  .kx-tarjeta-head { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.55rem; flex-wrap: wrap; }
  .kx-tarjeta-id { font-family: var(--kx-font-mono); font-size: 0.68rem; color: var(--kx-ink-faint); }
  .kx-tarjeta-pastillas { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .kx-tarjeta-titulo { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.35rem; line-height: 1.3; }
  .kx-tarjeta-desc {
    font-family: var(--kx-font-sans); font-size: 0.82rem; line-height: 1.55;
    color: var(--kx-ink-soft); margin: 0 0 0.5rem;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .kx-tarjeta-fecha { font-family: var(--kx-font-mono); font-size: 0.66rem; color: var(--kx-ink-faint); }
</style>
