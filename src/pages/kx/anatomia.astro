---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const modulos = await getCollection('kxModulos');
const piezas = await getCollection('kxPiezas');
const workflows = await getCollection('kxWorkflows');
const cuadrantes = await getCollection('kxCuadrantes');
const stack = await getCollection('kxStack');
const integraciones = await getCollection('kxIntegraciones');
const funcionalidades = await getCollection('kxFuncionalidades');

const ACTUAL_ESTADOS = ['construyendo', 'activo', 'finalizado', 'pausado', 'deprecado'];
const VISION_ESTADOS = ['idea', 'disenado'];

const ESTADO_META = {
  idea:         { label: 'idea',         color: 'var(--st-idea)' },
  disenado:     { label: 'diseñado',     color: 'var(--st-disenado)' },
  construyendo: { label: 'construyendo', color: 'var(--st-construyendo)' },
  activo:       { label: 'live',         color: 'var(--st-activo)' },
  finalizado:   { label: 'finalizado',   color: 'var(--st-finalizado)' },
  pausado:      { label: 'pausado',      color: 'var(--st-pausado)' },
  deprecado:    { label: 'deprecado',    color: 'var(--st-idea)' },
};

const skills = piezas.filter((p) => p.data.tipo === 'skill');
const templates = piezas.filter((p) => p.data.tipo === 'template');
const stackSoftware = stack.filter((s) => s.data.categoria === 'software');
const stackHardware = stack.filter((s) => s.data.categoria === 'hardware');

function porVista(items, vista) {
  const set = vista === 'actual' ? ACTUAL_ESTADOS : VISION_ESTADOS;
  return items.filter((i) => set.includes(i.data.estado));
}

const TAXONOMIA_IDS = [
  { prefijo: 'KX-S{NN}', significa: 'Sesión kx core (el id vive en el frontmatter, no en el nombre del archivo)', ejemplo: 'KX-S03', vive: '00 - Kx Core Module/02 - Ensamblaje/Sesiones/' },
  { prefijo: 'KX-M', significa: 'Módulo (slug kebab, no numerado)', ejemplo: 'modulo-base', vive: 'kx-modulos/' },
  { prefijo: 'KX-P{NN}', significa: 'Pieza — skill, flujo, template, convención, integración', ejemplo: 'KX-P08', vive: 'kx-piezas/' },
  { prefijo: 'KX-T{NN}', significa: 'Tarea del backlog', ejemplo: 'KX-T22', vive: 'kx-tareas/' },
];

const TAXONOMIA_ESTADOS = [
  { valor: 'idea', significa: 'Existe como concepto. Nada escrito todavía' },
  { valor: 'disenado', significa: 'Hay spec o diseño. No hay implementación' },
  { valor: 'construyendo', significa: 'En obra ahora mismo' },
  { valor: 'activo (se muestra "live")', significa: 'En producción, deployado, se usa de verdad — pero todavía se le sigue agregando y testeando. No implica terminado' },
  { valor: 'finalizado', significa: 'Terminado. No queda nada pendiente sobre esto, estable' },
  { valor: 'pausado', significa: 'Existe pero congelado a propósito' },
  { valor: 'deprecado', significa: 'Se retiró' },
];

const TAXONOMIA_TIPOS_TAREA = [
  { valor: 'decidir', significa: 'Requiere una decisión de Teo. Suele bloquear otras tareas' },
  { valor: 'pensar', significa: 'No está claro todavía qué se construye — necesita diseño' },
  { valor: 'construir', significa: 'Ya está claro qué se construye. Es ejecución' },
  { valor: 'escribir', significa: 'Producir contenido o contexto, dictando' },
  { valor: 'aclarar', significa: 'Input dictado tan corto o cortado que no se entiende bien — no es una tarea todavía, es una cita cruda esperando triage' },
];

const TAXONOMIA_NAMING = [
  { patron: 'kx {nombre} module', aplica: 'titulo de todo módulo del dashboard', ejemplo: 'kx core module, kx sesiones module' },
  { patron: '{AA.MM.DD} - kx core session[ - II]', aplica: 'sesiones del kx core module', ejemplo: '26.07.28 - kx core session - II' },
  { patron: '{AA.MM} - Patch Notes', aplica: 'archivo mensual del log de eventos del sistema', ejemplo: '26.07 - Patch Notes' },
  { patron: '{AA.MM.DD} - Class {A/B/C}[ - II]', aplica: 'stream sessions de 01 - Sesiones/', ejemplo: '26.07.25 - Class A - IV' },
  { patron: 'innie / outie', aplica: 'rama de limpieza — hacia adentro (self-archivo) vs hacia afuera (publicación)', ejemplo: 'limpieza-innie, limpieza-outie' },
  { patron: 'BANDERA: TIPO', aplica: 'marcador inline dictado en voz, mayúscula, línea propia', ejemplo: 'BANDERA: TRASPASO DE TEMA' },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
    <script is:inline>
        try { if (localStorage.getItem('kx-theme') === 'dark') document.documentElement.classList.add('theme-dark'); } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Anatomía — kx</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Reenie+Beanie&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FCFAF5; --ink: #23211d; --ink-soft: #55503f; --ink-faint: #8c8070;
            --line: #ddd4bf; --teal: #2A4747; --gold: #B08D57; --seal: #8B2626;
            --panel: #F5F1E6; --panel-2: #EFE9D9;
            --st-idea: #8c8070; --st-disenado: #9B7CC8; --st-construyendo: #B08D57;
            --st-activo: #7BA08A; --st-finalizado: #2A4747; --st-pausado: #B4BCC0;
            --topbar-bg: rgba(252,250,245,0.9);
        }
        html.theme-dark {
            --bg: #15130E; --ink: #EDE9DD; --ink-soft: #B7AF9C; --ink-faint: #857D6C;
            --line: #37342A; --teal: #4FD8DD; --gold: #E6BA76; --seal: #FF7A6B;
            --panel: #201D16; --panel-2: #29251C;
            --st-idea: #A79B87; --st-disenado: #B79FFF; --st-construyendo: #E6BA76;
            --st-activo: #8FE8BC; --st-finalizado: #4FD8DD; --st-pausado: #C7D3D8;
            --topbar-bg: rgba(21,19,14,0.9);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background-color: var(--bg);
            color: var(--ink);
            font-family: "EB Garamond", serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .paper-overlay {
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image: url("https://www.transparenttextures.com/patterns/natural-paper.png"), url("https://www.transparenttextures.com/patterns/natural-paper.png");
            background-position: 0px 0px, 40px 60px;
            background-repeat: repeat;
        }
        html.theme-dark .paper-overlay { filter: invert(1) grayscale(1) brightness(1.7); mix-blend-mode: screen; opacity: 0.5; }
        .wrap { position: relative; z-index: 1; }
        .topbar { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 2rem; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--topbar-bg); backdrop-filter: blur(8px); z-index: 50; }
        .topbar-right { display: flex; align-items: center; gap: 1.1rem; }
        .theme-toggle {
            display: inline-flex; align-items: center; justify-content: center;
            width: 30px; height: 30px; border-radius: 50%;
            border: 1px solid var(--line); background: var(--panel); color: var(--ink);
            cursor: pointer; font-size: 0.9rem; line-height: 1; padding: 0;
            transition: border-color 0.2s ease, transform 0.2s ease;
        }
        .theme-toggle:hover { border-color: var(--teal); transform: translateY(-1px); }
        .brand { display: flex; align-items: baseline; gap: 0.6rem; text-decoration: none; font-family: "Reenie Beanie", cursive; font-size: 1.6rem; color: var(--ink); }
        .brand small { font-family: "Inter", sans-serif; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
        .crumbs { font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
        .crumbs a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--line); }
        .crumbs a:hover { color: var(--teal); border-color: var(--teal); }
        .crumbs .current { color: var(--ink); }

        .wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

        .hero { padding: 3rem 0 1.5rem; }
        .kicker { font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.9rem; }
        .hero h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 0.7rem; }
        .hero .lede { font-style: italic; color: var(--ink-soft); font-size: 1.1rem; max-width: 62ch; margin: 0; line-height: 1.5; }

        /* sticky toggle */
        .toggle-bar {
            position: sticky; top: 62px; z-index: 40; background: var(--bg);
            padding: 1rem 0; margin-bottom: 0.5rem; border-bottom: 1px solid var(--line);
        }
        .toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--panel); }
        .toggle button { font-family: "Inter", sans-serif; font-size: 0.82rem; font-weight: 600; border: none; background: none; padding: 0.55rem 1.3rem; border-radius: 999px; cursor: pointer; color: var(--ink-soft); transition: all 0.2s ease; }
        .toggle button.on { background: var(--ink); color: var(--bg); }
        .toggle-note { font-family: "Inter", sans-serif; font-size: 0.72rem; color: var(--ink-faint); margin-left: 1rem; }

        .section { margin: 2.6rem 0; }
        .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
        .section-head h2 { font-size: 1.35rem; font-weight: 600; margin: 0; }
        .section-count { font-family: "JetBrains Mono", monospace; font-size: 0.7rem; color: var(--ink-faint); }
        .section-hint { font-family: "Inter", sans-serif; font-size: 0.8rem; color: var(--ink-soft); margin: -0.5rem 0 1rem; max-width: 65ch; }

        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.8rem; }
        .grid.two-col { grid-template-columns: repeat(2, 1fr); }
        @media (max-width: 640px) { .grid.two-col { grid-template-columns: 1fr; } }

        .obj-card {
            background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
            padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.5rem;
        }
        .obj-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; }
        .obj-id { font-family: "JetBrains Mono", monospace; font-size: 0.62rem; color: var(--ink-faint); }
        .obj-title { font-size: 1.02rem; font-weight: 600; margin: 0; line-height: 1.3; }
        .obj-desc { font-family: "Inter", sans-serif; font-size: 0.78rem; color: var(--ink-soft); line-height: 1.5; margin: 0; }
        .obj-link { font-family: "Inter", sans-serif; font-size: 0.72rem; color: var(--teal); text-decoration: none; border-bottom: 1px solid var(--line); align-self: flex-start; }
        .obj-link:hover { border-color: var(--teal); }

        .pill { display: inline-flex; align-items: center; gap: 0.4rem; font-family: "Inter", sans-serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 999px; white-space: nowrap; flex-shrink: 0; }
        .pill .dot { width: 6px; height: 6px; border-radius: 50%; }

        .empty-state {
            border: 1px dashed var(--line); border-radius: 8px; padding: 1.4rem 1.6rem;
            font-family: "Inter", sans-serif; font-size: 0.85rem; color: var(--ink-faint); font-style: italic;
            background: var(--panel-2);
        }
        .empty-state a { color: var(--gold); font-style: normal; }

        /* tiles (funcionalidades) */
        .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
        .tile {
            background: linear-gradient(160deg, var(--panel), var(--panel-2));
            border: 1px solid var(--line); border-radius: 12px; padding: 1.4rem 1.5rem;
            display: flex; flex-direction: column; gap: 0.7rem;
        }
        .tile-title { font-size: 1.15rem; font-weight: 600; margin: 0; }
        .tile-desc { font-family: "Inter", sans-serif; font-size: 0.82rem; color: var(--ink-soft); line-height: 1.55; margin: 0; }

        /* taxonomia (estático) */
        .taxo-block {
            background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.6rem 1.8rem;
        }
        .taxo-sub { font-size: 1.02rem; font-weight: 700; margin: 1.6rem 0 0.7rem; color: var(--teal); }
        .taxo-sub:first-child { margin-top: 0; }
        table.taxo { width: 100%; border-collapse: collapse; font-family: "Inter", sans-serif; font-size: 0.8rem; }
        table.taxo th { text-align: left; font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); padding: 0.4rem 0.6rem; border-bottom: 2px solid var(--ink); }
        table.taxo td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
        table.taxo code { font-family: "JetBrains Mono", monospace; font-size: 0.78rem; background: var(--panel); padding: 0.1rem 0.4rem; border-radius: 3px; }

        .footnav { margin: 5rem 0 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem; font-family: "Inter", sans-serif; font-size: 0.8rem; }
        .footnav a { text-decoration: none; color: var(--ink-soft); }
        .footnav a:hover { color: var(--teal); }

        [data-toggle-section] { display: none; }
        [data-toggle-section].on { display: block; }
    </style>
</head>
<body>
    <div class="paper-overlay" aria-hidden="true"></div>
    <div class="topbar">
        <a href="/astro-project-v2/kx/" class="brand">& <small>kx system</small></a>
        <div class="topbar-right">
            <nav class="crumbs">
                <a href="/astro-project-v2/">interlynkx</a> / <a href="/astro-project-v2/kx/">kx</a> / <span class="current">anatomía</span>
            </nav>
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema">🌙</button>
        </div>
    </div>

    <div class="wrap">
        <section class="hero">
            <div class="kicker">por tipo de objeto, no por tema</div>
            <h1>Anatomía del sistema</h1>
            <p class="lede">
                El mismo sistema, cortado horizontalmente en vez de por módulo: todos los módulos juntos,
                todas las skills juntas, todo el stack junto. Sirve para decir "agregá x acá" mirando la pantalla.
            </p>
        </section>

        <div class="toggle-bar">
            <div class="toggle" id="toggle">
                <button class="on" data-view="actual">Actual</button>
                <button data-view="vision">Proyectado</button>
            </div>
            <span class="toggle-note">aplica a todas las secciones excepto Taxonomía</span>
        </div>

        <!-- MÓDULOS -->
        <div class="section">
            <div class="section-head"><h2>Módulos</h2><span class="section-count">{modulos.length} totales</span></div>
            <div data-toggle-section class="on" data-slot="modulos-actual">
                <div class="grid">
                    {porVista(modulos, 'actual').map((m) => {
                        const meta = ESTADO_META[m.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top">
                                    <h3 class="obj-title">{m.data.titulo}</h3>
                                    <span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span>
                                </div>
                                <p class="obj-desc">{m.data.descripcion}</p>
                                {m.data.href && <a class="obj-link" href={m.data.href}>ver página &rarr;</a>}
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="modulos-vision">
                <div class="grid">
                    {porVista(modulos, 'vision').map((m) => {
                        const meta = ESTADO_META[m.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top">
                                    <h3 class="obj-title">{m.data.titulo}</h3>
                                    <span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span>
                                </div>
                                <p class="obj-desc">{m.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- SKILLS -->
        <div class="section">
            <div class="section-head"><h2>Skills</h2><span class="section-count">{skills.length} totales</span></div>
            <div data-toggle-section class="on" data-slot="skills-actual">
                <div class="grid">
                    {porVista(skills, 'actual').map((p) => {
                        const meta = ESTADO_META[p.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top">
                                    <span class="obj-id">{p.data.id}</span>
                                    <span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span>
                                </div>
                                <h3 class="obj-title">{p.data.titulo}</h3>
                                <p class="obj-desc">{p.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="skills-vision">
                <div class="grid">
                    {porVista(skills, 'vision').length === 0 && <div class="empty-state">Sin skills en estado idea/diseñado por ahora.</div>}
                    {porVista(skills, 'vision').map((p) => {
                        const meta = ESTADO_META[p.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><span class="obj-id">{p.data.id}</span><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                <h3 class="obj-title">{p.data.titulo}</h3>
                                <p class="obj-desc">{p.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- TEMPLATES -->
        <div class="section">
            <div class="section-head"><h2>Templates</h2><span class="section-count">{templates.length} totales</span></div>
            <div data-toggle-section class="on" data-slot="templates-actual">
                <div class="grid">
                    {porVista(templates, 'actual').map((p) => {
                        const meta = ESTADO_META[p.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><span class="obj-id">{p.data.id}</span><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                <h3 class="obj-title">{p.data.titulo}</h3>
                                <p class="obj-desc">{p.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="templates-vision">
                <div class="grid">
                    {porVista(templates, 'vision').length === 0 && <div class="empty-state">Sin templates en estado idea/diseñado por ahora.</div>}
                    {porVista(templates, 'vision').map((p) => {
                        const meta = ESTADO_META[p.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><span class="obj-id">{p.data.id}</span><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                <h3 class="obj-title">{p.data.titulo}</h3>
                                <p class="obj-desc">{p.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- QUADRANTS -->
        <div class="section">
            <div class="section-head"><h2>Quadrants</h2><span class="section-count">{cuadrantes.length} totales</span></div>
            <p class="section-hint">Matriz de dimensiones de vida — origen personal, no del sistema. Se define aparte y después se incorpora acá (ver <code>KX-T20</code>).</p>
            {cuadrantes.length === 0 && <div class="empty-state">Todavía sin definir — pendiente <code>KX-T20</code>.</div>}
            <div class="grid">
                {cuadrantes.map((c) => {
                    const meta = ESTADO_META[c.data.estado];
                    return (
                        <div class="obj-card">
                            <div class="obj-top"><h3 class="obj-title">{c.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                            <p class="obj-desc">{c.data.descripcion}</p>
                        </div>
                    );
                })}
            </div>
        </div>

        <!-- WORKFLOWS -->
        <div class="section">
            <div class="section-head"><h2>Workflows</h2><span class="section-count">{workflows.length} totales</span></div>
            <p class="section-hint">Instancias concretas de flujo por materia prima de entrada — ej. class a &rarr; limpieza-innie &rarr; estructura-innie, o sesión sistémica &rarr; destilar-sesion-kx. Sección creada, catálogo todavía sin cargar (ver <code>KX-T22</code>).</p>
            {workflows.length === 0 && <div class="empty-state">Sin instancias cargadas todavía — pendiente <code>KX-T22</code>. Se arman en una sesión dedicada.</div>}
            <div class="grid">
                {workflows.map((w) => {
                    const meta = ESTADO_META[w.data.estado];
                    return (
                        <div class="obj-card">
                            <div class="obj-top"><h3 class="obj-title">{w.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                            <p class="obj-desc">{w.data.descripcion}</p>
                        </div>
                    );
                })}
            </div>
        </div>

        <!-- TAXONOMY (estático, no vivo, sin toggle) -->
        <div class="section">
            <div class="section-head"><h2>KX Taxonomy</h2><span class="section-count">de referencia — no cambia con el toggle</span></div>
            <p class="section-hint">Nombres de archivo, prefijos de id, estados y convenciones de naming del sistema entero, en un solo lugar. Esto no vive en una colección — es referencia fija, se edita a mano cuando cambia una convención.</p>
            <div class="taxo-block">
                <div class="taxo-sub">Prefijos de id</div>
                <table class="taxo">
                    <thead><tr><th>Prefijo</th><th>Significa</th><th>Ejemplo</th><th>Vive en</th></tr></thead>
                    <tbody>
                        {TAXONOMIA_IDS.map((t) => (
                            <tr><td><code>{t.prefijo}</code></td><td>{t.significa}</td><td><code>{t.ejemplo}</code></td><td>{t.vive}</td></tr>
                        ))}
                    </tbody>
                </table>

                <div class="taxo-sub">Los seis estados</div>
                <table class="taxo">
                    <thead><tr><th>Valor</th><th>Significa</th></tr></thead>
                    <tbody>
                        {TAXONOMIA_ESTADOS.map((t) => (
                            <tr><td><code>{t.valor}</code></td><td>{t.significa}</td></tr>
                        ))}
                    </tbody>
                </table>

                <div class="taxo-sub">Los cuatro tipos de tarea</div>
                <table class="taxo">
                    <thead><tr><th>Valor</th><th>Significa</th></tr></thead>
                    <tbody>
                        {TAXONOMIA_TIPOS_TAREA.map((t) => (
                            <tr><td><code>{t.valor}</code></td><td>{t.significa}</td></tr>
                        ))}
                    </tbody>
                </table>

                <div class="taxo-sub">Patrones de naming</div>
                <table class="taxo">
                    <thead><tr><th>Patrón</th><th>Aplica a</th><th>Ejemplo</th></tr></thead>
                    <tbody>
                        {TAXONOMIA_NAMING.map((t) => (
                            <tr><td><code>{t.patron}</code></td><td>{t.aplica}</td><td>{t.ejemplo}</td></tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- OUTER TECH STACK -->
        <div class="section">
            <div class="section-head"><h2>Outer Tech Stack</h2><span class="section-count">{stackSoftware.length} totales</span></div>
            <p class="section-hint">Software y servicios de los que depende el flujo de trabajo, por fuera del sistema kx en sí.</p>
            <div data-toggle-section class="on" data-slot="stack-sw-actual">
                <div class="grid">
                    {porVista(stackSoftware, 'actual').map((s) => {
                        const meta = ESTADO_META[s.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><h3 class="obj-title">{s.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                {s.data.descripcion && <p class="obj-desc">{s.data.descripcion}</p>}
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="stack-sw-vision">
                <div class="grid">
                    {porVista(stackSoftware, 'vision').length === 0 && <div class="empty-state">Nada proyectado en el stack de software por ahora.</div>}
                    {porVista(stackSoftware, 'vision').map((s) => {
                        const meta = ESTADO_META[s.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><h3 class="obj-title">{s.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                {s.data.descripcion && <p class="obj-desc">{s.data.descripcion}</p>}
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- KX HARDWARE STACK -->
        <div class="section">
            <div class="section-head"><h2>KX Hardware Stack</h2><span class="section-count">{stackHardware.length} totales</span></div>
            <p class="section-hint">Los dispositivos físicos, con su presupuesto de fricción según dónde y cuándo se usan.</p>
            <div data-toggle-section class="on" data-slot="stack-hw-actual">
                <div class="grid">
                    {porVista(stackHardware, 'actual').map((s) => {
                        const meta = ESTADO_META[s.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><h3 class="obj-title">{s.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                {s.data.descripcion && <p class="obj-desc">{s.data.descripcion}</p>}
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="stack-hw-vision">
                <div class="grid">
                    {porVista(stackHardware, 'vision').length === 0 && <div class="empty-state">Nada proyectado en hardware por ahora.</div>}
                    {porVista(stackHardware, 'vision').map((s) => {
                        const meta = ESTADO_META[s.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><h3 class="obj-title">{s.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                {s.data.descripcion && <p class="obj-desc">{s.data.descripcion}</p>}
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- INTEGRATION WITH INTERLYNKX PAGE -->
        <div class="section">
            <div class="section-head"><h2>Integration with Interlynkx Page</h2><span class="section-count">{integraciones.length} totales</span></div>
            <p class="section-hint">Qué tipos de contenido ya tienen un pipeline que escribe directo en la página, y cuáles todavía se cargarían a mano.</p>
            <div data-toggle-section class="on" data-slot="integraciones-actual">
                <div class="grid">
                    {porVista(integraciones, 'actual').map((i) => {
                        const meta = ESTADO_META[i.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><h3 class="obj-title">{i.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                <p class="obj-desc">{i.data.descripcion}</p>
                                {i.data.ruta && <a class="obj-link" href={i.data.ruta}>ver página &rarr;</a>}
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="integraciones-vision">
                <div class="grid">
                    {porVista(integraciones, 'vision').length === 0 && <div class="empty-state">Nada proyectado en integraciones por ahora.</div>}
                    {porVista(integraciones, 'vision').map((i) => {
                        const meta = ESTADO_META[i.data.estado];
                        return (
                            <div class="obj-card">
                                <div class="obj-top"><h3 class="obj-title">{i.data.titulo}</h3><span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span></div>
                                <p class="obj-desc">{i.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <!-- FUNCTIONALITIES (tiles) -->
        <div class="section">
            <div class="section-head"><h2>Functionalities</h2><span class="section-count">{funcionalidades.length} totales</span></div>
            <div data-toggle-section class="on" data-slot="func-actual">
                <div class="tiles">
                    {porVista(funcionalidades, 'actual').map((f) => {
                        const meta = ESTADO_META[f.data.estado];
                        return (
                            <div class="tile">
                                <span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color}; align-self:flex-start;`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span>
                                <h3 class="tile-title">{f.data.titulo}</h3>
                                <p class="tile-desc">{f.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div data-toggle-section data-slot="func-vision">
                <div class="tiles">
                    {porVista(funcionalidades, 'vision').length === 0 && <div class="empty-state">Nada proyectado todavía — decímelo mirando esta sección y lo sumo.</div>}
                    {porVista(funcionalidades, 'vision').map((f) => {
                        const meta = ESTADO_META[f.data.estado];
                        return (
                            <div class="tile">
                                <span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color}; align-self:flex-start;`}><span class="dot" style={`background:${meta.color}`}></span>{meta.label}</span>
                                <h3 class="tile-title">{f.data.titulo}</h3>
                                <p class="tile-desc">{f.data.descripcion}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>

        <div class="footnav">
            <a href="/astro-project-v2/kx/sistema/">&larr; ver por módulo</a>
            <a href="/astro-project-v2/kx/">volver al hub &rarr;</a>
        </div>
    </div>

    <script is:inline>
        const themeToggle = document.getElementById('theme-toggle');
        function isDark() { return document.documentElement.classList.contains('theme-dark'); }
        function syncToggleIcon() { themeToggle.textContent = isDark() ? '☀' : '🌙'; }
        syncToggleIcon();
        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('theme-dark');
            try { localStorage.setItem('kx-theme', isDark() ? 'dark' : 'light'); } catch (e) {}
            syncToggleIcon();
        });

        const toggle = document.getElementById('toggle');
        const actualSlots = document.querySelectorAll('[data-slot$="-actual"]');
        const visionSlots = document.querySelectorAll('[data-slot$="-vision"]');
        toggle.addEventListener('click', (e) => {
            const btn = e.target.closest('button');
            if (!btn) return;
            toggle.querySelectorAll('button').forEach((b) => b.classList.remove('on'));
            btn.classList.add('on');
            const view = btn.dataset.view;
            actualSlots.forEach((el) => el.classList.toggle('on', view === 'actual'));
            visionSlots.forEach((el) => el.classList.toggle('on', view === 'vision'));
        });
    </script>
</body>
</html>
