---
// Una página por área de la Matriz. Las once salen de acá con el mismo molde:
// prosa de la bóveda (el porqué) + escalera de estados (el qué) + decisiones
// fechadas + lo que queda abierto.
//
// El molde es común a propósito, pero cada área va a recibir después su visual
// propio según su driver ontológico (cursograma para flujos, matriz para
// instancias, grilla para cuadrantes). Ver Plan de Hub Kx §4.
import { getCollection } from 'astro:content';
import KxShell from '../../../layouts/KxShell.astro';
import Kicker from '../../../components/kx/Kicker.astro';
import Prosa from '../../../components/kx/Prosa.astro';
import EscaleraEstados from '../../../components/kx/EscaleraEstados.astro';
import Medidor from '../../../components/kx/Medidor.astro';
import { fechaCorta, AREA_FUENTE } from '../../../lib/kx';

const base = '/astro-project-v2';

export async function getStaticPaths() {
  const areas = await getCollection('kxAreas');
  const modulos = await getCollection('kxModulos');
  const piezas = await getCollection('kxPiezas');
  const workflows = await getCollection('kxWorkflows');
  const cuadrantes = await getCollection('kxCuadrantes');
  const instancias = await getCollection('kxInstancias');
  const integraciones = await getCollection('kxIntegraciones');
  const documentos = await getCollection('kxDocumentos');

  const moduloTitulo = (id: string) => modulos.find((m) => m.id === id)?.data.titulo ?? id;

  const POR_COLECCION: Record<string, any[]> = {
    kxModulos: modulos.map((m) => ({
      id: undefined, titulo: m.data.titulo, estado: m.data.estado, descripcion: m.data.descripcion,
      fechaInicio: m.data.fechaInicio, fechaFin: m.data.fechaFin, actualizado: m.data.actualizado,
    })),
    kxWorkflows: workflows.map((w) => ({
      id: w.data.id, titulo: w.data.titulo, estado: w.data.estado, descripcion: w.data.descripcion,
      fechaInicio: w.data.fechaInicio, fechaFin: w.data.fechaFin, actualizado: w.data.actualizado,
      extra: w.data.categoria,
    })),
    kxCuadrantes: cuadrantes.map((c) => ({
      id: c.data.id, titulo: c.data.titulo, estado: c.data.estado, descripcion: c.data.descripcion,
      fechaInicio: c.data.fechaInicio, fechaFin: c.data.fechaFin, actualizado: c.data.actualizado,
    })),
    kxInstancias: instancias.map((i) => ({
      id: undefined, titulo: i.data.titulo, estado: i.data.estado, descripcion: i.data.descripcion,
      fechaInicio: i.data.fechaInicio, fechaFin: i.data.fechaFin, actualizado: i.data.actualizado,
      extra: i.data.ruta,
    })),
    kxIntegraciones: integraciones.map((i) => ({
      id: undefined, titulo: i.data.titulo, estado: i.data.estado, descripcion: i.data.descripcion,
      actualizado: i.data.actualizado,
    })),
    kxDocumentos: documentos.map((d) => ({
      id: d.data.id, titulo: d.data.titulo, estado: 'activo', descripcion: d.data.subtitulo,
      actualizado: d.data.actualizado, extra: moduloTitulo(d.data.modulo),
    })),
  };

  const piezasComo = (tipo: string) => piezas.filter((p) => p.data.tipo === tipo).map((p) => ({
    id: p.data.id, titulo: p.data.titulo, estado: p.data.estado, descripcion: p.data.descripcion,
    fechaInicio: p.data.fechaInicio, fechaFin: p.data.fechaFin, actualizado: p.data.actualizado,
    extra: moduloTitulo(p.data.modulo),
  }));

  return areas.map((area) => {
    const fuentes = AREA_FUENTE[area.data.id] ?? [];
    const objetos = fuentes.flatMap((f) =>
      f.filtroTipo ? piezasComo(f.filtroTipo) : (POR_COLECCION[f.coleccion] ?? [])
    );
    // Flujos lleva además su visual propio: los pasos como secuencia por actor.
    // Es su driver ontológico (secuencia y actor), y una tarjeta no lo muestra.
    const flujos = area.data.id === 'flujos'
      ? workflows.map((w) => ({
          id: w.data.id, titulo: w.data.titulo, estado: w.data.estado,
          materiaPrima: w.data.materiaPrima, destino: w.data.destino,
          cuelloDeBotella: w.data.cuelloDeBotella, pasos: w.data.pasos,
        }))
      : [];

    return { params: { area: area.data.id }, props: { area, objetos, flujos, esConceptual: fuentes.length === 0 } };
  });
}

const { area, objetos = [], flujos = [], esConceptual } = Astro.props;
const d = area.data;

// Color por actor, espejando el código de los diagramas Mermaid de Mapa de Flujos.
const ACTOR_COLOR: Record<string, string> = {
  Teo: '--kx-autoria-teo',
  IA: '--kx-autoria-ia',
  espera: '--kx-slate',
  build: '--kx-mint',
};
function actorDe(paso: string): { actor: string; texto: string; colorVar: string; falta: boolean } {
  const [rawActor, ...resto] = paso.split(' · ');
  const texto = resto.join(' · ') || rawActor;
  const actor = resto.length ? rawActor : '';
  const falta = /falta la skill/i.test(actor);
  const key = Object.keys(ACTOR_COLOR).find((k) => actor.startsWith(k));
  return { actor, texto, colorVar: falta ? '--kx-alert' : (key ? ACTOR_COLOR[key] : '--kx-gold'), falta };
}

const ORDEN = ['idea', 'disenado', 'construyendo', 'activo', 'finalizado', 'pausado', 'deprecado'];
const desglose = ORDEN.map((estado) => ({ estado, count: objetos.filter((o: any) => o.estado === estado).length }));
const decisiones = [...d.decisiones].sort((a, b) => b.fecha.getTime() - a.fecha.getTime());

const vacioPorArea: Record<string, string> = {
  cuadrantes: 'Ningún cuadrante cargado todavía. No es un hueco del sistema: la lista de cuadrantes hay que dictarla, y es la tarea KX-T20. Es el único prerequisito del hub que no se puede automatizar.',
  flujos: 'Los cinco flujos existen escritos, con tabla de pasos y diagrama, en Mapa de Flujos.md. Falta transcribirlos a la colección kx-workflows (KX-T22) para que aparezcan acá como objetos.',
};
---

<KxShell title={d.titulo} crumbs={[{ label: 'Atlas', href: `${base}/kx/atlas/` }, { label: d.titulo }]}>
  <Fragment slot="kicker"><Kicker texto={`atlas · ${d.id}`} color="mint" /></Fragment>
  <h1 slot="title">{d.titulo}</h1>
  <p class="kx-lede">{d.linea}</p>
  <span class="kx-fuente">Fuente en la bóveda: <code>{d.archivoBoveda}</code></span>

  {d.queEs && (
    <section class="kx-bloque">
      <Prosa md={d.queEs} />
    </section>
  )}

  {!esConceptual && (
    <>
      <div class="kx-shead">
        <h2>Inventario</h2>
        {objetos.length === 0 && <span class="kx-shead-count">0</span>}
      </div>
      {objetos.length > 0 && (
        <div class="kx-medidor-row"><Medidor valor={objetos.length} label={d.titulo.toLowerCase()} desglose={desglose} /></div>
      )}
      <EscaleraEstados objetos={objetos} vacio={vacioPorArea[d.id] ?? `Esta área todavía no tiene objetos cargados en su colección. La prosa de arriba sí existe, en ${d.archivoBoveda}.`} />
    </>
  )}

  {flujos.length > 0 && (
    <>
      <div class="kx-shead"><h2>Los pipelines, paso por paso</h2></div>
      <p class="kx-snote">Cada paso declara quién actúa. Un paso en rojo es un hueco: nadie lo cubre todavía.</p>
      <div class="kx-flujos">
        {flujos.map((f: any) => (
          <article class="kx-flujo">
            <header class="kx-flujo-head">
              <span class="kx-flujo-id">{f.id}</span>
              <h3>{f.titulo}</h3>
            </header>
            <dl class="kx-flujo-meta">
              <div><dt>materia prima</dt><dd>{f.materiaPrima}</dd></div>
              <div><dt>destino</dt><dd>{f.destino}</dd></div>
            </dl>
            <ol class="kx-pasos">
              {f.pasos.map((paso: string, i: number) => {
                const p = actorDe(paso);
                return (
                  <li class={`kx-paso ${p.falta ? 'is-falta' : ''}`} style={`--acolor: var(${p.colorVar})`}>
                    <span class="kx-paso-num">{i + 1}</span>
                    <span class="kx-paso-actor">{p.actor}</span>
                    <span class="kx-paso-texto">{p.texto}</span>
                  </li>
                );
              })}
            </ol>
            {f.cuelloDeBotella && (
              <p class="kx-cuello"><strong>Cuello de botella:</strong> {f.cuelloDeBotella}</p>
            )}
          </article>
        ))}
      </div>
    </>
  )}

  {esConceptual && (
    <p class="kx-conceptual">
      Área conceptual: no cataloga objetos, describe cómo funciona el sistema.
      Todo su contenido es la prosa de esta página, y su fuente es <code>{d.archivoBoveda}</code>.
    </p>
  )}

  {d.convenciones && (
    <>
      <div class="kx-shead"><h2>Convenciones</h2></div>
      <section class="kx-bloque"><Prosa md={d.convenciones} /></section>
    </>
  )}

  {decisiones.length > 0 && (
    <>
      <div class="kx-shead">
        <h2>Decisiones</h2>
        <span class="kx-shead-count">{decisiones.length}</span>
      </div>
      <div class="kx-decisiones">
        {decisiones.map((dec) => (
          <article class="kx-decision">
            <header>
              <span class="kx-decision-fecha">{fechaCorta(dec.fecha)}</span>
              <h3>{dec.titulo}</h3>
            </header>
            <Prosa md={dec.cuerpo} />
          </article>
        ))}
      </div>
    </>
  )}

  {d.abierto && (
    <>
      <div class="kx-shead"><h2>Abierto</h2></div>
      <section class="kx-bloque kx-bloque--abierto"><Prosa md={d.abierto} /></section>
    </>
  )}
</KxShell>

<style>
  .kx-lede { font-family: var(--kx-font-sans); font-size: 1rem; line-height: 1.6; color: var(--kx-ink-soft); margin: 0.8rem 0 0.7rem; max-width: 62ch; }
  .kx-fuente {
    display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--kx-font-sans);
    font-size: 0.74rem; color: var(--kx-ink-faint); background: var(--kx-panel);
    border: 1px solid var(--kx-line); border-radius: var(--kx-radius-pill); padding: 0.32rem 0.85rem;
  }
  .kx-fuente code { font-family: var(--kx-font-mono); font-size: 0.7rem; color: var(--kx-accent-deep); }

  .kx-shead { display: flex; align-items: baseline; gap: 0.8rem; margin: 2.8rem 0 1rem; }
  .kx-shead h2 { font-size: 1.3rem; font-weight: 500; margin: 0; }
  .kx-shead-count {
    font-family: var(--kx-font-mono); font-size: 0.72rem; color: var(--kx-accent-deep);
    background: var(--kx-accent-tint); padding: 0.15rem 0.5rem; border-radius: var(--kx-radius-pill);
  }
  .kx-bloque {
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg);
    padding: 1.4rem 1.6rem; margin-top: 1.6rem; box-shadow: 0 2px 10px var(--kx-shadow);
  }
  .kx-bloque--abierto { border-left: 3px solid var(--kx-gold); }
  .kx-medidor-row { max-width: 380px; margin-bottom: 1.6rem; }
  .kx-conceptual {
    font-family: var(--kx-font-sans); font-size: 0.85rem; line-height: 1.6; color: var(--kx-ink-soft);
    background: var(--kx-lavender-tint); border: 1px solid var(--kx-lavender-mid);
    border-radius: var(--kx-radius); padding: 1rem 1.2rem; margin-top: 1.6rem;
  }
  .kx-conceptual code { font-family: var(--kx-font-mono); font-size: 0.78rem; color: var(--kx-lavender-deep); }

  .kx-decisiones { display: flex; flex-direction: column; gap: 1rem; }
  .kx-decision {
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg);
    padding: 1.3rem 1.5rem; border-left: 3px solid var(--kx-lavender);
    box-shadow: 0 2px 8px var(--kx-shadow);
  }
  .kx-decision header { margin-bottom: 0.7rem; }
  .kx-decision-fecha { font-family: var(--kx-font-mono); font-size: 0.68rem; color: var(--kx-lavender-deep); font-weight: 600; }
  .kx-decision h3 { font-size: 1.1rem; font-weight: 600; margin: 0.25rem 0 0; line-height: 1.35; }

  .kx-snote { font-family: var(--kx-font-sans); font-size: 0.85rem; color: var(--kx-ink-soft); margin: -0.5rem 0 1.2rem; }
  .kx-flujos { display: flex; flex-direction: column; gap: 1.1rem; }
  .kx-flujo {
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg);
    padding: 1.3rem 1.5rem; box-shadow: 0 2px 10px var(--kx-shadow);
  }
  .kx-flujo-head { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.8rem; flex-wrap: wrap; }
  .kx-flujo-id { font-family: var(--kx-font-mono); font-size: 0.7rem; color: var(--kx-accent-deep); font-weight: 600; }
  .kx-flujo-head h3 { font-size: 1.15rem; font-weight: 600; margin: 0; }
  .kx-flujo-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0 0 1rem; }
  .kx-flujo-meta div { display: flex; flex-direction: column; gap: 0.15rem; }
  .kx-flujo-meta dt {
    font-family: var(--kx-font-sans); font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--kx-ink-faint);
  }
  .kx-flujo-meta dd { margin: 0; font-family: var(--kx-font-sans); font-size: 0.8rem; color: var(--kx-ink-soft); }
  .kx-pasos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .kx-paso {
    display: flex; align-items: baseline; gap: 0.7rem; padding: 0.55rem 0.9rem;
    background: color-mix(in srgb, var(--acolor) 10%, var(--kx-panel));
    border-left: 3px solid var(--acolor); border-radius: 0 var(--kx-radius-sm) var(--kx-radius-sm) 0;
    font-family: var(--kx-font-sans); font-size: 0.82rem;
  }
  .kx-paso.is-falta { border-style: dashed; }
  .kx-paso-num { font-family: var(--kx-font-mono); font-size: 0.68rem; font-weight: 700; color: var(--acolor); flex-shrink: 0; }
  .kx-paso-actor {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--acolor); flex-shrink: 0; min-width: 4.5rem;
  }
  .kx-paso-texto { color: var(--kx-ink); line-height: 1.5; }
  .kx-cuello {
    font-family: var(--kx-font-sans); font-size: 0.8rem; line-height: 1.55; color: var(--kx-ink-soft);
    margin: 1rem 0 0; padding: 0.7rem 1rem; background: var(--kx-gold-tint);
    border-radius: var(--kx-radius-sm); border-left: 3px solid var(--kx-gold);
  }
  .kx-cuello strong { color: var(--kx-gold-deep); }
</style>
