---
import { getCollection } from 'astro:content';
import {
  AREAS,
  AREA_DE_TIPO_PIEZA,
  ACTUAL_ESTADOS,
  VISION_ESTADOS,
  fechaCorta,
  diasDesde,
  ultimoMovimiento,
} from '../../lib/kx';

const modulos = await getCollection('kxModulos');
const piezas = await getCollection('kxPiezas');
const tareas = await getCollection('kxTareas');
const sesiones = await getCollection('kxSesiones');
const documentos = await getCollection('kxDocumentos');

const moduloTitulo = (id: string) => modulos.find((m) => m.id === id)?.data.titulo ?? id;

// ── pulso ──
const piezasVivasTotal = piezas.filter((p) => ['activo', 'construyendo'].includes(p.data.estado)).length;
const tareasAbiertasTotal = tareas.filter((t) => t.data.estado !== 'cerrada' && t.data.tipo !== 'aclarar').length;
const decisionesAbiertas = tareas.filter((t) => t.data.tipo === 'decidir' && t.data.estado !== 'cerrada');
const ultimo = ultimoMovimiento(modulos, piezas, tareas);
const diasUltimo = ultimo ? diasDesde(ultimo) : null;

const stats = [
  { value: modulos.length, label: 'módulos' },
  { value: piezasVivasTotal, label: 'piezas vivas' },
  { value: tareasAbiertasTotal, label: 'tareas abiertas' },
  { value: decisionesAbiertas.length, label: 'decisiones pendientes' },
  { value: diasUltimo === null ? 's/d' : diasUltimo === 0 ? 'hoy' : diasUltimo, label: diasUltimo === 0 ? 'día del último cambio' : 'días desde el último cambio' },
];

// ── retomar ──
const ultimaSesion = [...sesiones].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())[0] ?? null;

const enObra = [...modulos.map((m) => ({ ...m, kind: 'módulo' })), ...piezas.map((p) => ({ ...p, kind: p.data.tipo }))]
  .filter((o) => o.data.estado === 'construyendo')
  .sort((a, b) => b.data.actualizado.getTime() - a.data.actualizado.getTime());
const enObraTop = enObra.slice(0, 5);

const todosLosObjetos = [
  ...modulos.map((m) => ({ titulo: m.data.titulo, tipo: 'módulo', estado: m.data.estado, actualizado: m.data.actualizado })),
  ...piezas.map((p) => ({ titulo: p.data.titulo, tipo: p.data.tipo, estado: p.data.estado, actualizado: p.data.actualizado })),
  ...tareas.map((t) => ({ titulo: t.data.titulo, tipo: 'tarea', estado: t.data.estado, actualizado: t.data.actualizado })),
];
const seMovioUltimo = todosLosObjetos
  .sort((a, b) => b.actualizado.getTime() - a.actualizado.getTime())
  .slice(0, 5);

// ── entrar por área ──
const PALETA = [
  { c: 'var(--pal-1)', tint: 'var(--pal-1-tint)', mid: 'var(--pal-1-mid)', glow: 'var(--pal-1-glow)' },
  { c: 'var(--pal-2)', tint: 'var(--pal-2-tint)', mid: 'var(--pal-2-mid)', glow: 'var(--pal-2-glow)' },
  { c: 'var(--pal-3)', tint: 'var(--pal-3-tint)', mid: 'var(--pal-3-mid)', glow: 'var(--pal-3-glow)' },
  { c: 'var(--pal-4)', tint: 'var(--pal-4-tint)', mid: 'var(--pal-4-mid)', glow: 'var(--pal-4-glow)' },
];
const areasConDatos = AREAS.map((a, i) => {
  const piezasArea = piezas.filter((p) => AREA_DE_TIPO_PIEZA[p.data.tipo] === a.slug);
  const piezasVivas = piezasArea.filter((p) => ['activo', 'construyendo'].includes(p.data.estado)).length;
  return { ...a, piezasVivas, pal: PALETA[i % PALETA.length] };
});

// ── documentos ──
const documentosOrdenados = [...documentos].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// ── módulos ──
const modulosActual = modulos.filter((m) => ACTUAL_ESTADOS.includes(m.data.estado));
const modulosVision = modulos.filter((m) => VISION_ESTADOS.includes(m.data.estado));
const piezasDeModulo = (id: string) => piezas.filter((p) => p.data.modulo === id).length;

// ── vistas ──
const vistas = [
  { titulo: 'Sistema', desc: 'Módulos y piezas, actual y visión.', href: '/astro-project-v2/kx/sistema/', disponible: true },
  { titulo: 'Tareas', desc: 'El backlog agrupado por tipo.', href: '/astro-project-v2/kx/tareas/', disponible: true },
  { titulo: 'Anatomía', desc: 'Por tipo de objeto, con la taxonomía.', href: '/astro-project-v2/kx/anatomia/', disponible: true },
  { titulo: 'Áreas', desc: 'El sistema cortado por área, no por estado.', href: '/astro-project-v2/kx/areas/', disponible: true },
  { titulo: 'Sesiones', desc: 'Índice de sesiones, textual y mapa.', href: '/astro-project-v2/kx/sesiones/', disponible: false },
  { titulo: 'Patch notes', desc: 'El log de eventos del sistema.', href: '/astro-project-v2/kx/patch-notes/', disponible: false },
  { titulo: 'Flujos', desc: 'Los pipelines, instancia por etapa.', href: '/astro-project-v2/kx/flujos/', disponible: false },
  { titulo: 'Estructura', desc: 'El árbol de carpetas del sistema.', href: '/astro-project-v2/kx/estructura/', disponible: false },
];

const ESTADO_LABEL: Record<string, string> = {
  idea: 'idea', disenado: 'diseñado', construyendo: 'construyendo',
  activo: 'live', finalizado: 'finalizado', pausado: 'pausado', deprecado: 'deprecado',
};
---

<html lang="es">
<head>
    <script is:inline>
        try {
            if (localStorage.getItem('kx-theme') === 'dark') document.documentElement.classList.add('theme-dark');
        } catch (e) {}
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>kx atlas system · interlynkx</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Reenie+Beanie&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #26241F;
            --ink-soft: #6B6459;
            --ink-faint: #A39985;
            --paper: #FFFFFF;
            --cream: #FDFCF9;
            --line: #ECE7DC;
            --line-soft: #F2EEE4;
            --teal: #2F8F94;
            --teal-deep: #1F6367;
            --teal-tint: #E9F7F7;
            --teal-mid: #BFE9EA;
            --teal-glow: rgba(47,143,148,0.28);
            --gold: #B08D57;
            --nav-bg: rgba(253,252,249,0.82);
            --pal-1: #2F8F94; --pal-1-tint: #E9F7F7; --pal-1-mid: #BFE9EA; --pal-1-glow: rgba(47,143,148,0.35);
            --pal-2: #C6862E; --pal-2-tint: #FBF3E4; --pal-2-mid: #F0D9A8; --pal-2-glow: rgba(198,134,46,0.32);
            --pal-3: #B8657A; --pal-3-tint: #FBEDF0; --pal-3-mid: #F0C6D0; --pal-3-glow: rgba(184,101,122,0.3);
            --pal-4: #7C6FC4; --pal-4-tint: #F0EEFB; --pal-4-mid: #D6CFF2; --pal-4-glow: rgba(124,111,196,0.32);
            --danger: #C86A6A;
        }
        html.theme-dark {
            --ink: #EDE9DD;
            --ink-soft: #B7AF9C;
            --ink-faint: #857D6C;
            --paper: #211E18;
            --cream: #15130E;
            --line: #37342A;
            --line-soft: #2B271E;
            --teal: #4FD8DD;
            --teal-deep: #8CEBEE;
            --teal-tint: rgba(79,216,221,0.12);
            --teal-mid: rgba(79,216,221,0.4);
            --teal-glow: rgba(79,216,221,0.45);
            --gold: #E6BA76;
            --nav-bg: rgba(21,19,14,0.85);
            --pal-1: #4FD8DD; --pal-1-tint: rgba(79,216,221,0.10); --pal-1-mid: rgba(79,216,221,0.4); --pal-1-glow: rgba(79,216,221,0.55);
            --pal-2: #E6A94E; --pal-2-tint: rgba(230,169,78,0.10); --pal-2-mid: rgba(230,169,78,0.4); --pal-2-glow: rgba(230,169,78,0.5);
            --pal-3: #E68CA3; --pal-3-tint: rgba(230,140,163,0.10); --pal-3-mid: rgba(230,140,163,0.4); --pal-3-glow: rgba(230,140,163,0.5);
            --pal-4: #A69AF0; --pal-4-tint: rgba(166,154,240,0.10); --pal-4-mid: rgba(166,154,240,0.4); --pal-4-glow: rgba(166,154,240,0.5);
            --danger: var(--danger);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            background-color: var(--cream);
            color: var(--ink);
            font-family: "EB Garamond", serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color 0.25s ease, color 0.25s ease;
        }
        .paper-overlay {
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image:
                url("https://www.transparenttextures.com/patterns/natural-paper.png"),
                url("https://www.transparenttextures.com/patterns/natural-paper.png"),
                url("https://www.transparenttextures.com/patterns/natural-paper.png");
            background-position:
                0px 0px,
                40px 60px,
                80px 20px;
            background-repeat: repeat;
        }
        html.theme-dark .paper-overlay {
            filter: invert(1) grayscale(1) brightness(1.7);
            mix-blend-mode: screen;
            opacity: 0.5;
        }
        .nav, .wrap { position: relative; z-index: 1; }
        a { color: inherit; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(38,36,31,0.12); border-radius: 10px; }

        /* ── nav ── */
        .nav {
            position: sticky; top: 0; z-index: 40;
            display: flex; align-items: center; justify-content: space-between;
            height: 78px; padding: 0 2.2rem;
            background: var(--nav-bg);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--line);
        }
        .nav-left { display: flex; align-items: center; gap: 2.2rem; }
        .nav-right-group { display: flex; align-items: center; gap: 1.1rem; }
        .theme-toggle {
            display: inline-flex; align-items: center; justify-content: center;
            width: 34px; height: 34px; border-radius: 50%;
            border: 1px solid var(--line); background: var(--paper); color: var(--ink);
            cursor: pointer; font-size: 1rem; line-height: 1; padding: 0;
            transition: border-color 0.2s ease, transform 0.2s ease;
        }
        .theme-toggle:hover { border-color: var(--teal-mid); transform: translateY(-1px); }
        .nav-brand {
            font-family: "Inter", sans-serif; font-weight: 800; font-size: 0.98rem;
            letter-spacing: -0.01em; text-decoration: none; color: var(--ink);
            display: flex; align-items: center; gap: 0.5rem;
        }
        .nav-brand .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 10px rgba(47,143,148,0.55); }
        .nav-sep { width: 1px; height: 26px; background: var(--line); }
        .nav-links { display: flex; align-items: center; gap: 1.7rem; }
        .nav-links a {
            font-family: "Inter", sans-serif; font-size: 0.86rem; font-weight: 600;
            text-decoration: none; color: var(--ink-soft); transition: color 0.2s ease;
        }
        .nav-links a:hover { color: var(--teal-deep); }
        .nav-right { font-family: "Reenie Beanie", cursive; font-size: 1.65rem; color: var(--teal); }
        @media (max-width: 760px) { .nav-links { display: none; } }

        .wrap { max-width: 1180px; margin: 0 auto; padding: 0 1.6rem; }

        /* ── hero ── */
        .hero { padding: 4.5rem 0 2.5rem; max-width: 760px; }
        .kicker {
            font-family: "Inter", sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em;
            text-transform: uppercase; color: var(--gold); margin-bottom: 1rem;
        }
        .hero h1 {
            font-size: clamp(2.6rem, 6vw, 4.1rem); font-weight: 500; line-height: 1.04;
            letter-spacing: -0.015em; margin: 0 0 1.2rem;
        }
        .hero h1 .accent { font-style: italic; color: var(--teal-deep); position: relative; display: inline-block; }
        .swoosh { position: absolute; width: 108%; height: 14px; bottom: -6px; left: -4%; color: var(--teal); opacity: 0.85; overflow: visible; }
        .swoosh path { stroke-dasharray: 140; stroke-dashoffset: 140; animation: draw 0.9s cubic-bezier(0.22,1,0.36,1) 0.25s forwards; }
        @keyframes draw { to { stroke-dashoffset: 0; } }
        .hero .lede { font-size: 1.14rem; line-height: 1.65; color: var(--ink-soft); margin: 0; }

        /* ── pulse ── */
        .pulse { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.85rem; margin: 2.6rem 0 3.6rem; }
        @media (max-width: 900px) { .pulse { grid-template-columns: repeat(2, 1fr); } }
        .pulse-card {
            background: var(--paper); border: 1px solid var(--line); border-radius: 18px;
            padding: 1.3rem 1.1rem; text-align: center;
            box-shadow: 0 2px 10px rgba(38,36,31,0.045);
            transition: transform 0.25s cubic-bezier(0.22,1,0.36,1), box-shadow 0.25s ease, border-color 0.25s ease;
        }
        .pulse-card:hover {
            transform: translateY(-4px);
            border-color: var(--teal-mid);
            box-shadow: 0 0 0 1px var(--teal-mid), 0 16px 32px -14px var(--teal-glow);
        }
        .pulse-card b { display: block; font-size: clamp(1.7rem, 3.2vw, 2.3rem); font-weight: 600; color: var(--teal-deep); line-height: 1; margin-bottom: 0.5rem; text-shadow: 0 0 16px var(--teal-glow); }
        .pulse-card span { font-family: "Inter", sans-serif; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em; color: var(--ink-soft); }

        /* ── section head ── */
        .shead { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 3.6rem 0 0.4rem; }
        .shead h2 { font-size: 1.55rem; font-weight: 500; margin: 0; }
        .shead .tag {
            font-family: "Inter", sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--teal); background: var(--teal-tint);
            padding: 0.3rem 0.7rem; border-radius: 999px;
        }
        .num-ic { vertical-align: -1px; margin-right: 3px; }
        .snote { font-family: "Inter", sans-serif; font-size: 0.86rem; color: var(--ink-soft); margin: 0.4rem 0 1.4rem; max-width: 64ch; line-height: 1.55; }

        /* ── retomar ── */
        .retomar {
            display: grid; grid-template-columns: 1.1fr 1fr 1fr; gap: 1.1rem;
        }
        @media (max-width: 900px) { .retomar { grid-template-columns: 1fr; } }
        .rcard {
            background: var(--paper); border: 1px solid var(--line); border-radius: 20px;
            padding: 1.5rem 1.6rem; box-shadow: 0 2px 10px rgba(38,36,31,0.045);
        }
        .rcard h4 {
            font-family: "Inter", sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em;
            text-transform: uppercase; color: var(--teal-deep); margin: 0 0 1rem;
            display: flex; align-items: center; gap: 0.5rem;
        }
        .rcard h4::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--teal); }
        .sesion-id { font-family: "JetBrains Mono", monospace; font-size: 0.78rem; color: var(--teal-deep); font-weight: 600; }
        .sesion-fecha { font-family: "Inter", sans-serif; font-size: 0.72rem; color: var(--ink-faint); margin-left: 0.5rem; }
        .sesion-titulo { font-size: 1.15rem; line-height: 1.4; margin: 0.6rem 0 1rem; }
        .sesion-links { display: flex; gap: 0.5rem; }
        .sesion-links a {
            font-family: "Inter", sans-serif; font-size: 0.74rem; font-weight: 700; text-decoration: none;
            padding: 0.4rem 0.85rem; border-radius: 999px; background: var(--teal-tint); color: var(--teal-deep);
            transition: background 0.2s ease;
        }
        .sesion-links a:hover { background: var(--teal-mid); }
        .rrow { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; padding: 0.55rem 0; border-top: 1px solid var(--line-soft); }
        .rrow:first-child { border-top: none; }
        .rrow .t { font-family: "Inter", sans-serif; font-weight: 600; font-size: 0.86rem; }
        .rrow .m { font-family: "Inter", sans-serif; font-size: 0.68rem; color: var(--ink-faint); white-space: nowrap; margin-left: 0.6rem; }
        .rmore { display: inline-block; margin-top: 0.6rem; font-family: "Inter", sans-serif; font-size: 0.72rem; color: var(--teal-deep); text-decoration: none; font-weight: 600; }

        /* ── decisiones ── */
        .decisiones {
            background: var(--paper); border: 1px solid var(--line); border-left: 4px solid var(--danger); border-radius: 20px;
            padding: 0.3rem 1.6rem; margin-top: 1.1rem;
        }
        .drow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--line-soft); }
        .drow:first-child { border-top: none; }
        .drow .t { font-family: "Inter", sans-serif; font-size: 0.88rem; font-weight: 600; }
        .drow .b { font-family: "Inter", sans-serif; font-size: 0.64rem; font-weight: 700; color: var(--danger); white-space: nowrap; }

        /* ── areas ── */
        .areas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
        @media (max-width: 900px) { .areas-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 560px) { .areas-grid { grid-template-columns: 1fr; } }
        .area-card {
            display: block; text-decoration: none; color: var(--ink);
            background: var(--paper); border: 1px solid var(--line); border-radius: 20px;
            padding: 1.35rem 1.5rem; position: relative; overflow: hidden;
            transition: transform 0.22s cubic-bezier(0.22,1,0.36,1), border-color 0.22s ease, background 0.3s ease, box-shadow 0.3s ease;
        }
        .area-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: var(--ac); opacity: 0.85;
        }
        .area-card:hover {
            transform: translateY(-4px);
            background: linear-gradient(160deg, var(--paper) 0%, var(--ac-tint) 130%);
            border-color: var(--ac-mid);
            box-shadow: 0 0 0 1px var(--ac-mid), 0 18px 40px -14px var(--ac-glow);
        }
        .area-card h3 { font-size: 1.14rem; font-weight: 600; margin: 0.3rem 0 0.35rem; }
        .area-card p { font-family: "Inter", sans-serif; font-size: 0.8rem; color: var(--ink-soft); margin: 0; line-height: 1.5; min-height: 2.4em; }
        .area-count {
            display: inline-flex; margin-top: 0.85rem; font-family: "JetBrains Mono", monospace; font-size: 0.68rem;
            font-weight: 600; color: var(--ac); background: var(--ac-tint); padding: 0.25rem 0.6rem; border-radius: 999px;
        }

        /* ── documentos / modulos cards ── */
        .doc-grid { display: flex; flex-direction: column; gap: 1rem; }
        .doc-card {
            background: var(--paper); border: 1px solid var(--line); border-radius: 20px;
            padding: 1.6rem 1.8rem; box-shadow: 0 2px 10px rgba(38,36,31,0.045);
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }
        .doc-card:hover { border-color: var(--teal-mid); box-shadow: 0 16px 32px -18px var(--teal-glow); }
        .doc-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
        .doc-id { font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: var(--teal-deep); font-weight: 600; letter-spacing: 0.02em; }
        .doc-status { font-family: "Inter", sans-serif; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); text-align: right; }
        .doc-title { font-size: 1.4rem; font-weight: 500; margin: 0 0 0.4rem; }
        .doc-desc { font-family: "Inter", sans-serif; font-size: 0.88rem; line-height: 1.6; color: var(--ink-soft); margin: 0; }
        .doc-links { display: flex; gap: 0.6rem; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--line-soft); }
        .doc-links a {
            font-family: "Inter", sans-serif; font-size: 0.76rem; font-weight: 700; text-decoration: none;
            padding: 0.45rem 0.95rem; border-radius: 999px; transition: all 0.2s ease;
        }
        .doc-links a.primary { background: var(--teal); color: #fff; }
        .doc-links a.primary:hover { background: var(--teal-deep); }
        .doc-links a.secondary { background: var(--teal-tint); color: var(--teal-deep); }
        .doc-links a.secondary:hover { background: var(--teal-mid); }

        /* ── modulos ── */
        .modulos-list { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: 0.3rem 1.6rem; }
        .mod-row { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 1rem; padding: 0.9rem 0; border-top: 1px solid var(--line-soft); }
        .mod-row:first-child { border-top: none; }
        @media (max-width: 620px) { .mod-row { grid-template-columns: 1fr auto; row-gap: 0.3rem; } }
        .mod-title { font-family: "Inter", sans-serif; font-weight: 600; font-size: 0.94rem; }
        .mod-chip {
            display: inline-flex; align-items: center; gap: 0.4rem; font-family: "Inter", sans-serif;
            font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft);
        }
        .mod-chip .dot { width: 7px; height: 7px; border-radius: 50%; }
        .mod-count { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; color: var(--ink-faint); white-space: nowrap; }
        .modulos-vision { margin-top: 0.9rem; opacity: 0.7; }

        /* ── vistas ── */
        .vistas-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.85rem; }
        @media (max-width: 820px) { .vistas-grid { grid-template-columns: repeat(2, 1fr); } }
        .vista-card {
            display: block; text-decoration: none; color: var(--ink);
            background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 1.05rem 1.2rem;
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        a.vista-card:hover { transform: translateY(-3px); border-color: var(--teal-mid); box-shadow: 0 14px 26px -16px var(--teal-glow); }
        .vista-card.stub { opacity: 0.42; cursor: default; }
        .vista-card h4 { font-size: 0.96rem; font-weight: 600; margin: 0 0 0.3rem; }
        .vista-card p { font-family: "Inter", sans-serif; font-size: 0.75rem; color: var(--ink-soft); margin: 0; line-height: 1.4; }
        .vista-badge { display: inline-block; margin-top: 0.55rem; font-family: "Inter", sans-serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-faint); }

        /* ── footer ── */
        .footer {
            margin: 5.5rem 0 3.5rem; padding-top: 1.6rem; border-top: 1px solid var(--line);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem;
            font-family: "Inter", sans-serif; font-size: 0.8rem; color: var(--ink-faint);
        }
        .footer a { text-decoration: none; color: var(--ink-soft); font-weight: 600; }
        .footer a:hover { color: var(--teal-deep); }
    </style>
</head>
<body>
    <div class="paper-overlay" aria-hidden="true"></div>
    <div class="nav">
        <div class="nav-left">
            <a href="/astro-project-v2/kx/" class="nav-brand"><span class="dot"></span>kx atlas system</a>
            <div class="nav-sep"></div>
            <nav class="nav-links">
                <a href="/astro-project-v2/kx/sistema/">Sistema</a>
                <a href="/astro-project-v2/kx/tareas/">Tareas</a>
                <a href="/astro-project-v2/kx/anatomia/">Anatomía</a>
                <a href="/astro-project-v2/kx/areas/">Áreas</a>
            </nav>
        </div>
        <div class="nav-right-group">
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg></button>
            <a href="/astro-project-v2/" class="nav-right">hyperlynkx | teo</a>
        </div>
    </div>

    <div class="wrap">
        <section class="hero">
            <div class="kicker">back end · interlynkx</div>
            <h1>El mapa de todo el <span class="accent">kx
                <svg class="swoosh" viewBox="0 0 100 10" fill="none" preserveAspectRatio="none">
                    <path d="M0,8 C25,12 75,4 100,8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
            </span> system</h1>
            <p class="lede">
                No un módulo más: el que describe a todos los demás. Módulos, skills, flujos e integraciones,
                en un solo lugar. Esta página se dibuja sola desde el estado del sistema.
            </p>
        </section>

        <div class="pulse">
            {stats.map((s) => (
                <div class="pulse-card">
                    <b>{s.value}</b>
                    <span>{s.label}</span>
                </div>
            ))}
        </div>

        {(ultimaSesion || enObraTop.length > 0 || seMovioUltimo.length > 0) && (
            <>
                <div class="shead">
                    <h2>Retomar</h2>
                    <span class="tag"><svg class="num-ic" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="9" x2="19" y2="9"></line><line x1="5" y1="15" x2="19" y2="15"></line><line x1="10" y1="4" x2="8" y2="20"></line><line x1="15" y1="4" x2="13" y2="20"></line></svg>1</span>
                </div>
                <p class="snote">Lo último que pasó, y lo que está a medio hacer.</p>
                <div class="retomar">
                    {ultimaSesion && (
                        <div class="rcard">
                            <h4>Última sesión</h4>
                            <div>
                                <span class="sesion-id">{ultimaSesion.data.id}</span>
                                <span class="sesion-fecha">{fechaCorta(ultimaSesion.data.fecha)}</span>
                                <p class="sesion-titulo">{ultimaSesion.data.titulo}</p>
                                <div class="sesion-links">
                                    {ultimaSesion.data.hrefTextual && <a href={ultimaSesion.data.hrefTextual}>textual</a>}
                                    {ultimaSesion.data.hrefMapa && <a href={ultimaSesion.data.hrefMapa}>mapa</a>}
                                </div>
                            </div>
                        </div>
                    )}
                    {enObraTop.length > 0 && (
                        <div class="rcard">
                            <h4>En obra</h4>
                            {enObraTop.map((o) => (
                                <div class="rrow">
                                    <span class="t">{o.data.titulo}</span>
                                    <span class="m">{o.kind}</span>
                                </div>
                            ))}
                            {enObra.length > 5 && <a class="rmore" href="/astro-project-v2/kx/sistema/">y {enObra.length - 5} más &rarr;</a>}
                        </div>
                    )}
                    {seMovioUltimo.length > 0 && (
                        <div class="rcard">
                            <h4>Se movió último</h4>
                            {seMovioUltimo.map((o) => (
                                <div class="rrow">
                                    <span class="t">{o.titulo}</span>
                                    <span class="m">{fechaCorta(o.actualizado)}</span>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </>
        )}

        {decisionesAbiertas.length > 0 && (
            <div class="decisiones">
                {decisionesAbiertas.slice(0, 5).map((d) => {
                    const bloquea = tareas.filter((t) => t.data.bloqueadaPor?.includes(d.id)).length;
                    return (
                        <div class="drow">
                            <span class="t">{d.data.titulo}</span>
                            {bloquea > 0 && <span class="b">BLOQUEA {bloquea}</span>}
                        </div>
                    );
                })}
            </div>
        )}

        <div class="shead">
            <h2>Entrar por área</h2>
            <span class="tag"><svg class="num-ic" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="9" x2="19" y2="9"></line><line x1="5" y1="15" x2="19" y2="15"></line><line x1="10" y1="4" x2="8" y2="20"></line><line x1="15" y1="4" x2="13" y2="20"></line></svg>2</span>
        </div>
        <p class="snote">Las once áreas de la Matriz. Es el eje con el que se pide el trabajo, no el estado ni el tipo.</p>
        <div class="areas-grid">
            {areasConDatos.map((a) => (
                <a class="area-card" href={`/astro-project-v2/kx/areas/${a.slug}/`}
                   style={`--ac: ${a.pal.c}; --ac-tint: ${a.pal.tint}; --ac-mid: ${a.pal.mid}; --ac-glow: ${a.pal.glow};`}>
                    <h3>{a.label}</h3>
                    <p>{a.linea}</p>
                    {a.piezasVivas > 0 && <span class="area-count">{a.piezasVivas} {a.piezasVivas === 1 ? 'pieza' : 'piezas'}</span>}
                </a>
            ))}
        </div>

        {documentosOrdenados.length > 0 && (
            <>
                <div class="shead">
                    <h2>Documentos</h2>
                    <span class="tag"><svg class="num-ic" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="9" x2="19" y2="9"></line><line x1="5" y1="15" x2="19" y2="15"></line><line x1="10" y1="4" x2="8" y2="20"></line><line x1="15" y1="4" x2="13" y2="20"></line></svg>3</span>
                </div>
                <p class="snote">Cada documento se publica en pareja: prosa completa y mapa visual.</p>
                <div class="doc-grid">
                    {documentosOrdenados.map((doc) => (
                        <div class="doc-card">
                            <div class="doc-row">
                                <span class="doc-id">{doc.data.id} · {moduloTitulo(doc.data.modulo)}</span>
                                <span class="doc-status">{doc.data.estado}</span>
                            </div>
                            <h3 class="doc-title">{doc.data.titulo}</h3>
                            <p class="doc-desc">{doc.data.subtitulo}</p>
                            <div class="doc-links">
                                {doc.data.hrefMapa && <a class="secondary" href={doc.data.hrefMapa}>mapa visual</a>}
                                <a class="primary" href={doc.data.hrefTextual}>{doc.data.hrefMapa ? 'análisis completo' : 'leer'}</a>
                            </div>
                        </div>
                    ))}
                </div>
            </>
        )}

        <div class="shead">
            <h2>Módulos</h2>
            <span class="tag"><svg class="num-ic" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="9" x2="19" y2="9"></line><line x1="5" y1="15" x2="19" y2="15"></line><line x1="10" y1="4" x2="8" y2="20"></line><line x1="15" y1="4" x2="13" y2="20"></line></svg>4</span>
        </div>
        <p class="snote">{modulos.length} hoy. Los de abajo existen como decisión, no como código todavía.</p>
        <div class="modulos-list">
            {modulosActual.map((m) => (
                <div class="mod-row">
                    <span class="mod-title">{m.data.titulo}</span>
                    <span class="mod-chip"><span class="dot" style={`background: var(--teal)`}></span>{ESTADO_LABEL[m.data.estado] ?? m.data.estado}</span>
                    <span class="mod-count">{piezasDeModulo(m.id)} piezas</span>
                </div>
            ))}
        </div>
        {modulosVision.length > 0 && (
            <div class="modulos-list modulos-vision">
                {modulosVision.map((m) => (
                    <div class="mod-row">
                        <span class="mod-title">{m.data.titulo}</span>
                        <span class="mod-chip"><span class="dot" style="background: var(--ink-faint)"></span>{ESTADO_LABEL[m.data.estado] ?? m.data.estado}</span>
                        <span class="mod-count">{piezasDeModulo(m.id)} piezas</span>
                    </div>
                ))}
            </div>
        )}

        <div class="shead">
            <h2>Vistas</h2>
            <span class="tag"><svg class="num-ic" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="9" x2="19" y2="9"></line><line x1="5" y1="15" x2="19" y2="15"></line><line x1="10" y1="4" x2="8" y2="20"></line><line x1="15" y1="4" x2="13" y2="20"></line></svg>5</span>
        </div>
        <p class="snote">Las lecturas del sistema. Algunas todavía no existen.</p>
        <div class="vistas-grid">
            {vistas.map((v) => v.disponible ? (
                <a class="vista-card" href={v.href}>
                    <h4>{v.titulo}</h4>
                    <p>{v.desc}</p>
                </a>
            ) : (
                <div class="vista-card stub">
                    <h4>{v.titulo}</h4>
                    <p>{v.desc}</p>
                    <span class="vista-badge">sin construir</span>
                </div>
            ))}
        </div>

        <div class="footer">
            <a href="/astro-project-v2/">&larr; volver a interlynkx</a>
            <span>dibujado el {fechaCorta(new Date())}</span>
        </div>
    </div>
    <script is:inline>
        const themeToggle = document.getElementById('theme-toggle');
        function isDark() { return document.documentElement.classList.contains('theme-dark'); }
        function syncToggleIcon() { themeToggle.innerHTML = isDark() ? '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>' : '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>'; }
        syncToggleIcon();
        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('theme-dark');
            try { localStorage.setItem('kx-theme', isDark() ? 'dark' : 'light'); } catch (e) {}
            syncToggleIcon();
        });
    </script>
</body>
</html>
