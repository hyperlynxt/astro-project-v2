---
import { getCollection } from 'astro:content';
import KxShell from '../../layouts/KxShell.astro';
import Kicker from '../../components/kx/Kicker.astro';
import Medidor from '../../components/kx/Medidor.astro';
import Pastilla from '../../components/kx/Pastilla.astro';
import TarjetaObjeto from '../../components/kx/TarjetaObjeto.astro';
import Timeline from '../../components/kx/Timeline.astro';
import TimelineItem from '../../components/kx/TimelineItem.astro';
import { fechaCorta, diasDesde, ultimoMovimiento } from '../../lib/kx';

const base = '/astro-project-v2';

const modulos = await getCollection('kxModulos');
const piezas = await getCollection('kxPiezas');
const tareas = await getCollection('kxTareas');
const sesiones = await getCollection('kxSesiones');
const ciclos = await getCollection('kxCiclos');
const eventos = await getCollection('kxEventos');

// ── el ciclo activo, si lo hay: primero de todo si existe ──
const cicloActivo = ciclos.find((c) => c.data.estado_ciclo === 'activo') ?? null;

// ── última sesión ──
const ultimaSesion = [...sesiones].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())[0] ?? null;
const sesionesSinProcesar = sesiones.filter((s) => s.data.estado_autopoiesis === 'sin-procesar').length;

// ── se movió último, cruzando las tres colecciones de estado ──
const todosLosObjetos = [
  ...modulos.map((m) => ({ titulo: m.data.titulo, tipo: 'módulo', actualizado: m.data.actualizado })),
  ...piezas.map((p) => ({ titulo: p.data.titulo, tipo: p.data.tipo, actualizado: p.data.actualizado })),
  ...tareas.map((t) => ({ titulo: t.data.titulo, tipo: 'tarea', actualizado: t.data.actualizado })),
];
const seMovioUltimo = todosLosObjetos.sort((a, b) => b.actualizado.getTime() - a.actualizado.getTime()).slice(0, 5);
const ultimo = ultimoMovimiento(modulos, piezas, tareas);
const diasUltimo = ultimo ? diasDesde(ultimo) : null;

// ── medidor: área Atlas ──
const ESTADOS_ORDEN = ['idea', 'disenado', 'construyendo', 'activo', 'finalizado', 'pausado', 'deprecado'];
const desgloseEstado = (items: { data: { estado: string } }[]) =>
  ESTADOS_ORDEN.map((estado) => ({ estado, count: items.filter((i) => i.data.estado === estado).length }));

const atlasTotal = modulos.length + piezas.length;
const atlasDesglose = desgloseEstado([...modulos, ...piezas]);

// ── medidor: área autopoiesis ──
const tareasNoTriage = tareas.filter((t) => t.data.tipo !== 'aclarar');
const autopoiesisDesglose = [
  { estado: 'abierta', count: tareasNoTriage.filter((t) => t.data.estado === 'abierta').length },
  { estado: 'bloqueada', count: tareasNoTriage.filter((t) => t.data.estado === 'bloqueada').length },
  { estado: 'cerrada', count: tareasNoTriage.filter((t) => t.data.estado === 'cerrada').length },
];

// ── bloqueando: decisiones abiertas ──
const decisionesAbiertas = tareas.filter((t) => t.data.tipo === 'decidir' && t.data.estado !== 'cerrada');

// ── pulso: últimos eventos del log ──
const pulso = [...eventos].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()).slice(0, 8);

const VERBO_COLOR: Record<string, string> = {
  creado: 'var(--kx-mint)', implementado: 'var(--kx-mint-deep)', decidido: 'var(--kx-lavender)',
  cambiado: 'var(--kx-sky)', calibrado: 'var(--kx-gold)', deprecado: 'var(--kx-slate)',
  abierto: 'var(--kx-clay)', cerrado: 'var(--kx-mint-deep)',
};
---

<KxShell title="kx system">
  <Fragment slot="kicker"><Kicker texto="hub · atlas + autopoiesis" /></Fragment>
  <h1 slot="title">Dos áreas, un sistema: <em>ver</em> y <em>cambiar</em></h1>

  <p class="kx-lede">
    El Atlas mapea lo que existe. La autopoiesis es cómo cambia. Cada una tiene su lugar;
    lo que produce una se ve reflejado en la otra.
  </p>

  {cicloActivo && (
    <div class="kx-ciclo-activo">
      <span class="kx-ciclo-kicker">ciclo activo · {cicloActivo.data.id}</span>
      <p class="kx-ciclo-tema">{cicloActivo.data.tema}</p>
      <a class="kx-ciclo-link" href={`${base}/kx/autopoiesis/ciclos/`}>ver la bitácora completa &rarr;</a>
    </div>
  )}

  <div class="kx-shead">
    <h2>Las dos áreas</h2>
  </div>
  <div class="kx-areas-grid">
    <a class="kx-area-panel" href={`${base}/kx/atlas/`} style="--pcolor: var(--kx-mint)">
      <Kicker texto="ver el sistema" color="mint" />
      <h3>Atlas</h3>
      <Medidor valor={atlasTotal} label="módulos + piezas" desglose={atlasDesglose} />
    </a>
    <a class="kx-area-panel" href={`${base}/kx/autopoiesis/`} style="--pcolor: var(--kx-lavender)">
      <Kicker texto="cambiar el sistema" color="lavender" />
      <h3>Autopoiesis</h3>
      <Medidor valor={tareasNoTriage.length} label="tareas en total" desglose={autopoiesisDesglose} rampa="estadoTarea" />
    </a>
  </div>

  <div class="kx-shead">
    <h2>Retomar</h2>
  </div>
  <p class="kx-snote">Lo último que pasó, y lo que está a medio hacer.</p>
  <div class="kx-retomar-grid">
    {ultimaSesion && (
      <div class="kx-rcard">
        <h4>Última sesión</h4>
        <span class="kx-mono">{ultimaSesion.data.id}</span>
        <span class="kx-fecha">{fechaCorta(ultimaSesion.data.fecha)}</span>
        <p class="kx-rcard-titulo">{ultimaSesion.data.titulo || 'sin título todavía'}</p>
        {sesionesSinProcesar > 0 && <Pastilla rampa="estadoTarea" valor="abierta" label={`${sesionesSinProcesar} sin procesar`} />}
      </div>
    )}
    <div class="kx-rcard">
      <h4>Se movió último</h4>
      {seMovioUltimo.map((o) => (
        <div class="kx-rrow"><span>{o.titulo}</span><span class="kx-fecha">{fechaCorta(o.actualizado)}</span></div>
      ))}
      {diasUltimo !== null && <p class="kx-rcard-foot">{diasUltimo === 0 ? 'hoy' : `hace ${diasUltimo} día${diasUltimo === 1 ? '' : 's'}`}</p>}
    </div>
    {decisionesAbiertas.length > 0 && (
      <div class="kx-rcard kx-rcard--alerta">
        <h4>Bloqueando</h4>
        {decisionesAbiertas.slice(0, 5).map((d) => {
          const bloquea = tareas.filter((t) => t.data.bloqueadaPor?.includes(d.id)).length;
          return (
            <div class="kx-rrow">
              <span>{d.data.titulo}</span>
              {bloquea > 0 && <span class="kx-alerta-tag">bloquea {bloquea}</span>}
            </div>
          );
        })}
      </div>
    )}
  </div>

  <div class="kx-shead">
    <h2>Pulso</h2>
    <a class="kx-vermas" href={`${base}/kx/autopoiesis/log/`}>ver el log completo &rarr;</a>
  </div>
  <p class="kx-snote">Los últimos eventos del sistema.</p>
  <Timeline tieneItems={pulso.length > 0} vacio="Sin eventos registrados todavía.">
    {pulso.map((e) => (
      <TimelineItem fecha={e.data.fecha} color={VERBO_COLOR[e.data.verbo] ?? 'var(--kx-accent)'}>
        <div class="kx-pulso-row">
          <span class="kx-pulso-area">{e.data.area}</span>
          <span class="kx-pulso-verbo">{e.data.verbo}</span>
          <span class="kx-pulso-texto">{e.data.texto}</span>
        </div>
      </TimelineItem>
    ))}
  </Timeline>
</KxShell>

<style>
  .kx-lede { font-family: var(--kx-font-sans); font-size: 1.02rem; line-height: 1.6; color: var(--kx-ink-soft); max-width: 62ch; margin: 0.9rem 0 0; }
  .kx-lede em { font-style: italic; color: var(--kx-accent-deep); }

  .kx-ciclo-activo {
    margin-top: 1.8rem; padding: 1.1rem 1.5rem; border-radius: var(--kx-radius-lg);
    background: linear-gradient(120deg, var(--kx-mint-tint), var(--kx-lavender-tint) 70%);
    border: 1px solid var(--kx-accent-mid);
  }
  .kx-ciclo-kicker { font-family: var(--kx-font-sans); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--kx-accent-deep); }
  .kx-ciclo-tema { font-size: 1.1rem; margin: 0.5rem 0 0.6rem; line-height: 1.4; }
  .kx-ciclo-link { font-family: var(--kx-font-sans); font-size: 0.78rem; font-weight: 700; color: var(--kx-accent-deep); text-decoration: none; }
  .kx-ciclo-link:hover { text-decoration: underline; }

  .kx-shead { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 3rem 0 0.3rem; }
  .kx-shead h2 { font-size: 1.4rem; font-weight: 500; margin: 0; }
  .kx-vermas { font-family: var(--kx-font-sans); font-size: 0.78rem; font-weight: 700; color: var(--kx-accent-deep); text-decoration: none; }
  .kx-vermas:hover { text-decoration: underline; }
  .kx-snote { font-family: var(--kx-font-sans); font-size: 0.85rem; color: var(--kx-ink-soft); margin: 0.4rem 0 1.2rem; }

  .kx-areas-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 720px) { .kx-areas-grid { grid-template-columns: 1fr; } }
  .kx-area-panel {
    display: block; text-decoration: none; color: var(--kx-ink);
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg);
    padding: 1.5rem; position: relative; overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.22,1,0.36,1), border-color 0.22s ease, box-shadow 0.3s ease;
  }
  .kx-area-panel::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--pcolor); }
  .kx-area-panel:hover { transform: translateY(-4px); border-color: var(--pcolor); box-shadow: 0 18px 40px -18px var(--pcolor); }
  .kx-area-panel h3 { font-size: 1.5rem; font-weight: 500; margin: 0.3rem 0 1rem; }

  .kx-retomar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 900px) { .kx-retomar-grid { grid-template-columns: 1fr; } }
  .kx-rcard { background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg); padding: 1.3rem 1.4rem; box-shadow: 0 2px 10px var(--kx-shadow); }
  .kx-rcard--alerta { border-color: var(--kx-alert-tint); border-left: 3px solid var(--kx-alert); }
  .kx-rcard h4 { font-family: var(--kx-font-sans); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--kx-accent-deep); margin: 0 0 0.8rem; }
  .kx-mono { font-family: var(--kx-font-mono); font-size: 0.76rem; color: var(--kx-accent-deep); font-weight: 600; }
  .kx-fecha { font-family: var(--kx-font-mono); font-size: 0.66rem; color: var(--kx-ink-faint); margin-left: 0.4rem; }
  .kx-rcard-titulo { font-size: 1rem; line-height: 1.4; margin: 0.6rem 0 0.7rem; }
  .kx-rrow { display: flex; align-items: baseline; justify-content: space-between; gap: 0.7rem; padding: 0.5rem 0; border-top: 1px solid var(--kx-line-soft); font-family: var(--kx-font-sans); font-size: 0.85rem; }
  .kx-rrow:first-child { border-top: none; }
  .kx-rcard-foot { font-family: var(--kx-font-sans); font-size: 0.72rem; color: var(--kx-ink-faint); margin: 0.6rem 0 0; }
  .kx-alerta-tag { font-family: var(--kx-font-sans); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; color: var(--kx-alert); white-space: nowrap; }

  .kx-pulso-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; font-family: var(--kx-font-sans); font-size: 0.84rem; }
  .kx-pulso-area {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--kx-ink-faint); background: var(--kx-panel); border: 1px solid var(--kx-line);
    padding: 0.15rem 0.5rem; border-radius: var(--kx-radius-pill);
  }
  .kx-pulso-verbo { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; color: var(--kx-ink-faint); }
  .kx-pulso-texto { color: var(--kx-ink-soft); line-height: 1.5; }
</style>
