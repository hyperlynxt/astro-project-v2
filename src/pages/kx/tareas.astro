---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const tareas = await getCollection('kxTareas');
const modulos = await getCollection('kxModulos');

const moduloTitulo = (id) => modulos.find((m) => m.id === id)?.data.titulo ?? id;

const TIPOS = [
  { key: 'decidir', label: 'Decidir', hint: 'solo vos', color: 'var(--seal)' },
  { key: 'pensar', label: 'Pensar', hint: 'vos y yo juntos', color: 'var(--st-disenado)' },
  { key: 'construir', label: 'Construir', hint: 'ejecución', color: 'var(--st-finalizado)' },
  { key: 'escribir', label: 'Escribir', hint: 'vos dictando', color: 'var(--gold)' },
];

const ACLARAR = { key: 'aclarar', label: 'Aclarar', hint: 'input crudo, no se entiende bien', color: 'var(--st-idea)' };

const ESTADO_META = {
  abierta: { label: 'abierta', color: 'var(--gold)' },
  bloqueada: { label: 'bloqueada', color: 'var(--seal)' },
  cerrada: { label: 'cerrada', color: 'var(--st-activo)' },
};

const PRIORIDAD_META = {
  alta: { label: 'alta', color: 'var(--seal)' },
  media: { label: 'media', color: 'var(--gold)' },
  baja: { label: 'baja', color: 'var(--st-idea)' },
};

function porTipo(tipo) {
  return tareas
    .filter((t) => t.data.tipo === tipo)
    .sort((a, b) => {
      const orden = { bloqueada: 0, abierta: 1, cerrada: 2 };
      return orden[a.data.estado] - orden[b.data.estado] || a.data.id.localeCompare(b.data.id);
    });
}

const tareasPM = tareas.filter((t) => t.data.tipo !== 'aclarar');
const tareasAclarar = porTipo('aclarar');

// decisiones abiertas que bloquean algo
const decisionesAbiertas = tareasPM.filter((t) => t.data.tipo === 'decidir' && t.data.estado !== 'cerrada');
const bloqueosPorDecision = decisionesAbiertas.map((d) => ({
  decision: d,
  bloquea: tareasPM.filter((t) => t.data.bloqueadaPor?.includes(d.data.id)),
})).filter((b) => b.bloquea.length > 0);

const totalAbiertas = tareasPM.filter((t) => t.data.estado !== 'cerrada').length;
const totalCerradas = tareasPM.filter((t) => t.data.estado === 'cerrada').length;
const totalBloqueadas = tareasPM.filter((t) => t.data.estado === 'bloqueada').length;
const totalAltaPrioridad = tareasPM.filter((t) => t.data.prioridad === 'alta' && t.data.estado !== 'cerrada').length;

const modulosEnUso = [...new Set(tareasPM.map((t) => t.data.modulo).filter(Boolean))]
  .map((id) => ({ id, titulo: moduloTitulo(id) }))
  .sort((a, b) => a.titulo.localeCompare(b.titulo));

function cardAttrs(t) {
  return {
    'data-modulo': t.data.modulo ?? '',
    'data-prioridad': t.data.prioridad ?? '',
    'data-estado': t.data.estado,
  };
}
---

<!DOCTYPE html>
<html lang="es">
<head>
    <script is:inline>
        try { if (localStorage.getItem('kx-theme') === 'dark') document.documentElement.classList.add('theme-dark'); } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tareas — kx</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Reenie+Beanie&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FCFAF5; --ink: #23211d; --ink-soft: #55503f; --ink-faint: #8c8070;
            --line: #ddd4bf; --teal: #2A4747; --gold: #B08D57; --seal: #8B2626;
            --panel: #F5F1E6; --panel-2: #EFE9D9;
            --st-idea: #8c8070; --st-disenado: #9B7CC8; --st-finalizado: #2A4747; --st-activo: #7BA08A;
            --teal-glow: rgba(42,71,71,0.25); --tint-danger: #FBF0EC;
        }
        html.theme-dark {
            --bg: #15130E; --ink: #EDE9DD; --ink-soft: #B7AF9C; --ink-faint: #857D6C;
            --line: #37342A; --teal: #4FD8DD; --gold: #E6BA76; --seal: #FF7A6B;
            --panel: #201D16; --panel-2: #29251C;
            --st-idea: #A79B87; --st-disenado: #B79FFF; --st-finalizado: #4FD8DD; --st-activo: #8FE8BC;
            --teal-glow: rgba(79,216,221,0.45); --tint-danger: rgba(255,122,107,0.08);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background-color: var(--bg);
            color: var(--ink);
            font-family: "EB Garamond", serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .paper-overlay {
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image: url("https://www.transparenttextures.com/patterns/natural-paper.png"), url("https://www.transparenttextures.com/patterns/natural-paper.png");
            background-position: 0px 0px, 40px 60px;
            background-repeat: repeat;
        }
        html.theme-dark .paper-overlay { filter: invert(1) grayscale(1) brightness(1.7); mix-blend-mode: screen; opacity: 0.5; }
        .topbar, .wrap { position: relative; z-index: 1; }
        .topbar { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 2rem; border-bottom: 1px solid var(--line); }
        .topbar-right { display: flex; align-items: center; gap: 1.1rem; }
        .theme-toggle {
            display: inline-flex; align-items: center; justify-content: center;
            width: 30px; height: 30px; border-radius: 50%;
            border: 1px solid var(--line); background: var(--panel); color: var(--ink);
            cursor: pointer; font-size: 0.9rem; line-height: 1; padding: 0;
            transition: border-color 0.2s ease, transform 0.2s ease;
        }
        .theme-toggle:hover { border-color: var(--teal); transform: translateY(-1px); }
        .brand { display: flex; align-items: baseline; gap: 0.6rem; text-decoration: none; font-family: "Reenie Beanie", cursive; font-size: 1.6rem; color: var(--ink); }
        .brand small { font-family: "Inter", sans-serif; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
        .crumbs { font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
        .crumbs a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--line); }
        .crumbs a:hover { color: var(--teal); border-color: var(--teal); }
        .crumbs .current { color: var(--ink); }

        .wrap { max-width: 1320px; margin: 0 auto; padding: 0 1.5rem; }

        .hero { padding: 3.5rem 0 1.5rem; }
        .kicker { font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.9rem; }
        .hero h1 { font-size: clamp(2.3rem, 5.5vw, 3.6rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 0.7rem; }
        .hero .lede { font-style: italic; color: var(--ink-soft); font-size: 1.15rem; max-width: 62ch; margin: 0; line-height: 1.5; }

        .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 2.2rem 0 1.5rem; }
        .stat { padding: 1.2rem 1rem; text-align: center; border-left: 1px solid var(--line); }
        .stat:first-child { border-left: none; }
        .stat b { display: block; font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 600; color: var(--teal); line-height: 1; margin-bottom: 0.35rem; text-shadow: 0 0 16px var(--teal-glow); }
        .stat.warn b { color: var(--seal); }
        .stat span { font-family: "Inter", sans-serif; font-size: 0.66rem; letter-spacing: 0.04em; color: var(--ink-soft); line-height: 1.3; display: block; }
        @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } }

        .filters {
            display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem;
            background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
            padding: 0.9rem 1.2rem; margin-bottom: 2.2rem;
            font-family: "Inter", sans-serif;
        }
        .filter-group { display: flex; align-items: center; gap: 0.5rem; }
        .filter-group label { font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
        .filter-group select {
            font-family: "Inter", sans-serif; font-size: 0.78rem; color: var(--ink);
            background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 0.3rem 0.5rem;
        }
        .filter-toggle { display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; color: var(--ink-soft); cursor: pointer; user-select: none; }
        .filter-toggle input { accent-color: var(--teal); }
        .filter-reset {
            margin-left: auto; font-size: 0.72rem; color: var(--teal); text-decoration: none;
            border-bottom: 1px solid var(--teal); cursor: pointer; background: none; border-top: none; border-left: none; border-right: none; padding: 0;
        }
        .filter-count { font-size: 0.72rem; color: var(--ink-faint); }

        .blockers {
            background: var(--tint-danger); border: 1px solid var(--seal); border-radius: 10px;
            padding: 1.2rem 1.4rem; margin-bottom: 2.5rem;
        }
        .blockers h3 {
            margin: 0 0 0.9rem; font-size: 0.95rem; font-weight: 700; color: var(--seal);
            font-family: "Inter", sans-serif; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.75rem;
        }
        .blocker-item { margin-bottom: 0.7rem; }
        .blocker-item:last-child { margin-bottom: 0; }
        .blocker-item .d-title { font-weight: 600; font-size: 0.92rem; }
        .blocker-item .d-id { font-family: "JetBrains Mono", monospace; font-size: 0.65rem; color: var(--ink-faint); margin-right: 0.4rem; }
        .blocker-item .d-blocks {
            font-family: "Inter", sans-serif; font-size: 0.76rem; color: var(--ink-soft); margin: 0.25rem 0 0;
        }

        .board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
        @media (max-width: 1000px) { .board { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 560px) { .board { grid-template-columns: 1fr; } }

        .col-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.8rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--col-color); }
        .col-head h2 { font-size: 1.05rem; font-weight: 700; margin: 0; color: var(--col-color); }
        .col-head .hint { font-family: "Inter", sans-serif; font-size: 0.64rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; }
        .col-empty { font-family: "Inter", sans-serif; font-size: 0.72rem; color: var(--ink-faint); font-style: italic; padding: 0.6rem 0; }

        .card {
            background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
            padding: 0.85rem 1rem; margin-bottom: 0.7rem;
        }
        .card.cerrada { opacity: 0.5; }
        .card.cerrada .card-title { text-decoration: line-through; }
        .card.hidden-by-filter { display: none; }
        .card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.35rem; }
        .card-id { font-family: "JetBrains Mono", monospace; font-size: 0.62rem; color: var(--ink-faint); }
        .card-pills { display: flex; gap: 0.3rem; }
        .pill { display: inline-flex; align-items: center; gap: 0.35rem; font-family: "Inter", sans-serif; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: 999px; white-space: nowrap; }
        .pill .dot { width: 5px; height: 5px; border-radius: 50%; }
        .card-title { font-family: "Inter", sans-serif; font-weight: 600; font-size: 0.85rem; line-height: 1.35; margin: 0 0 0.4rem; }
        .card-desc { font-family: "Inter", sans-serif; font-size: 0.74rem; color: var(--ink-soft); line-height: 1.45; margin: 0 0 0.5rem; }
        .card-quote {
            font-family: "EB Garamond", serif; font-style: italic; font-size: 0.8rem; color: var(--ink-soft);
            border-left: 2px solid var(--line); padding-left: 0.6rem; margin: 0 0 0.5rem;
        }
        .card-meta { display: flex; flex-wrap: wrap; gap: 0.4rem; font-family: "Inter", sans-serif; font-size: 0.62rem; color: var(--ink-faint); }
        .card-tag { background: var(--panel-2); padding: 0.15rem 0.5rem; border-radius: 4px; }

        .aclarar-section { margin-top: 3rem; }
        .aclarar-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.5rem; padding-bottom: 0.6rem; border-bottom: 2px dashed var(--ink-faint); }
        .aclarar-head h2 { font-size: 1.05rem; font-weight: 700; margin: 0; color: var(--ink-faint); }
        .aclarar-note { font-family: "Inter", sans-serif; font-size: 0.78rem; color: var(--ink-soft); max-width: 60ch; margin: 0 0 1.2rem; line-height: 1.5; }
        .aclarar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
        @media (max-width: 900px) { .aclarar-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 560px) { .aclarar-grid { grid-template-columns: 1fr; } }
        .card.aclarar { border-style: dashed; border-color: var(--ink-faint); }

        .footnav { margin: 5rem 0 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem; font-family: "Inter", sans-serif; font-size: 0.8rem; }
        .footnav a { text-decoration: none; color: var(--ink-soft); }
        .footnav a:hover { color: var(--teal); }
    </style>
</head>
<body>
    <div class="paper-overlay" aria-hidden="true"></div>
    <div class="topbar">
        <a href="/astro-project-v2/kx/" class="brand">& <small>kx system</small></a>
        <div class="topbar-right">
            <nav class="crumbs">
                <a href="/astro-project-v2/">interlynkx</a> / <a href="/astro-project-v2/kx/">kx</a> / <span class="current">tareas</span>
            </nav>
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema">🌙</button>
        </div>
    </div>

    <div class="wrap">
        <section class="hero">
            <div class="kicker">backlog del sistema · vista de project management</div>
            <h1>Qué queda</h1>
            <p class="lede">
                Agrupado por quién la puede desbloquear, no por cuándo se anotó. Las decisiones
                que están bloqueando algo van primero. Filtrá por módulo o prioridad para enfocar
                una sola parte del sistema a la vez.
            </p>
        </section>

        <div class="stats">
            <div class="stat"><b>{totalAbiertas}</b><span>tareas abiertas</span></div>
            <div class="stat"><b>{totalBloqueadas}</b><span>bloqueadas</span></div>
            <div class="stat"><b>{totalCerradas}</b><span>cerradas</span></div>
            <div class={`stat ${totalAltaPrioridad > 0 ? 'warn' : ''}`}><b>{totalAltaPrioridad}</b><span>prioridad alta, abiertas</span></div>
        </div>

        <div class="filters">
            <div class="filter-group">
                <label for="f-modulo">módulo</label>
                <select id="f-modulo">
                    <option value="">todos</option>
                    {modulosEnUso.map((m) => <option value={m.id}>{m.titulo}</option>)}
                </select>
            </div>
            <div class="filter-group">
                <label for="f-prioridad">prioridad</label>
                <select id="f-prioridad">
                    <option value="">todas</option>
                    <option value="alta">alta</option>
                    <option value="media">media</option>
                    <option value="baja">baja</option>
                </select>
            </div>
            <label class="filter-toggle">
                <input type="checkbox" id="f-ocultar-cerradas" checked />
                ocultar cerradas
            </label>
            <span class="filter-count" id="f-count"></span>
            <button class="filter-reset" id="f-reset" type="button">reset</button>
        </div>

        {bloqueosPorDecision.length > 0 && (
            <div class="blockers">
                <h3>Decisiones tuyas bloqueando tareas</h3>
                {bloqueosPorDecision.map(({ decision, bloquea }) => (
                    <div class="blocker-item">
                        <span class="d-id">{decision.data.id}</span>
                        <span class="d-title">{decision.data.titulo}</span>
                        <p class="d-blocks">
                            bloquea: {bloquea.map((b) => b.data.id).join(', ')} — {bloquea.map((b) => b.data.titulo).join(' · ')}
                        </p>
                    </div>
                ))}
            </div>
        )}

        <div class="board">
            {TIPOS.map((tipo) => {
                const items = porTipo(tipo.key);
                return (
                    <div class="col" style={`--col-color: ${tipo.color}`}>
                        <div class="col-head">
                            <h2>{tipo.label}</h2>
                            <span class="hint">{tipo.hint}</span>
                        </div>
                        {items.length === 0 && <p class="col-empty">nada acá</p>}
                        {items.map((t) => {
                            const meta = ESTADO_META[t.data.estado];
                            const prio = t.data.prioridad ? PRIORIDAD_META[t.data.prioridad] : null;
                            return (
                                <div class={`card ${t.data.estado === 'cerrada' ? 'cerrada' : ''}`} {...cardAttrs(t)}>
                                    <div class="card-top">
                                        <span class="card-id">{t.data.id}</span>
                                        <div class="card-pills">
                                            {prio && (
                                                <span class="pill" style={`background:color-mix(in srgb, ${prio.color} 16%, transparent); color:${prio.color};`}>
                                                    <span class="dot" style={`background:${prio.color}`}></span>
                                                    {prio.label}
                                                </span>
                                            )}
                                            <span class="pill" style={`background:color-mix(in srgb, ${meta.color} 16%, transparent); color:${meta.color};`}>
                                                <span class="dot" style={`background:${meta.color}`}></span>
                                                {meta.label}
                                            </span>
                                        </div>
                                    </div>
                                    <p class="card-title">{t.data.titulo}</p>
                                    <p class="card-desc">{t.data.descripcion}</p>
                                    <div class="card-meta">
                                        {t.data.modulo && <span class="card-tag">{moduloTitulo(t.data.modulo)}</span>}
                                        {t.data.bloqueadaPor?.map((bid) => <span class="card-tag">bloqueada por {bid}</span>)}
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                );
            })}
        </div>

        {tareasAclarar.length > 0 && (
            <section class="aclarar-section">
                <div class="aclarar-head">
                    <h2>Aclarar</h2>
                    <span class="hint" style="font-family: 'Inter', sans-serif; font-size: 0.64rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em;">
                        {tareasAclarar.length} sin triage
                    </span>
                </div>
                <p class="aclarar-note">
                    Input dictado tan chico o cortado que no se termina de entender qué se quiso decir.
                    No son tareas todavía — son la cita cruda, esperando que Teo las retome y las convierta
                    en algo de las cuatro columnas de arriba, o las descarte.
                </p>
                <div class="aclarar-grid">
                    {tareasAclarar.map((t) => (
                        <div class="card aclarar" {...cardAttrs(t)}>
                            <div class="card-top">
                                <span class="card-id">{t.data.id}</span>
                            </div>
                            <p class="card-title">{t.data.titulo}</p>
                            {t.data.notaOriginal && <p class="card-quote">"{t.data.notaOriginal}"</p>}
                            <p class="card-desc">{t.data.descripcion}</p>
                        </div>
                    ))}
                </div>
            </section>
        )}

        <div class="footnav">
            <a href="/astro-project-v2/kx/sistema/">&larr; ver sistema</a>
            <a href="/astro-project-v2/kx/">volver al hub &rarr;</a>
        </div>
    </div>

    <script is:inline>
        const themeToggle = document.getElementById('theme-toggle');
        function isDark() { return document.documentElement.classList.contains('theme-dark'); }
        function syncToggleIcon() { themeToggle.textContent = isDark() ? '☀' : '🌙'; }
        syncToggleIcon();
        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('theme-dark');
            try { localStorage.setItem('kx-theme', isDark() ? 'dark' : 'light'); } catch (e) {}
            syncToggleIcon();
        });
    </script>
    <script>
        const selModulo = document.getElementById('f-modulo');
        const selPrioridad = document.getElementById('f-prioridad');
        const chkOcultarCerradas = document.getElementById('f-ocultar-cerradas');
        const btnReset = document.getElementById('f-reset');
        const countLabel = document.getElementById('f-count');
        const cards = Array.from(document.querySelectorAll('.card'));

        function applyFilters() {
            const modulo = selModulo.value;
            const prioridad = selPrioridad.value;
            const ocultarCerradas = chkOcultarCerradas.checked;
            let visible = 0;

            cards.forEach((card) => {
                const matchesModulo = !modulo || card.dataset.modulo === modulo;
                const matchesPrioridad = !prioridad || card.dataset.prioridad === prioridad;
                const matchesEstado = !ocultarCerradas || card.dataset.estado !== 'cerrada';
                const show = matchesModulo && matchesPrioridad && matchesEstado;
                card.classList.toggle('hidden-by-filter', !show);
                if (show) visible += 1;
            });

            countLabel.textContent = `${visible} de ${cards.length} visibles`;
        }

        selModulo.addEventListener('change', applyFilters);
        selPrioridad.addEventListener('change', applyFilters);
        chkOcultarCerradas.addEventListener('change', applyFilters);
        btnReset.addEventListener('click', () => {
            selModulo.value = '';
            selPrioridad.value = '';
            chkOcultarCerradas.checked = true;
            applyFilters();
        });

        applyFilters();
    </script>
</body>
</html>
