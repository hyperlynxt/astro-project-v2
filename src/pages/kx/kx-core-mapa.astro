---

<!DOCTYPE html>
<html lang="es">
<head>
    <script is:inline>
        try { if (localStorage.getItem('kx-theme') === 'dark') document.documentElement.classList.add('theme-dark'); } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Kx Core Module · mapa visual · kx system</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Reenie+Beanie&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FCFAF5;
            --ink: #23211d;
            --ink-soft: #55503f;
            --ink-faint: #8c8070;
            --line: #ddd4bf;
            --teal: #2A4747;
            --gold: #B08D57;
            --seal: #8B2626;
            --panel: #F5F1E6;
            --panel-2: #EFE9D9;
            --st-idea: #8c8070; --st-disenado: #9B7CC8; --st-construyendo: #B08D57;
            --st-activo: #7BA08A; --st-finalizado: #2A4747; --st-pausado: #B4BCC0;
            --teal-glow: rgba(42,71,71,0.25); --tint-ok: #E9F0E9; --tint-warn: #FBF3E3; --badge-ink: #FCFAF5;
        }
        html.theme-dark {
            --bg: #15130E;
            --ink: #EDE9DD;
            --ink-soft: #B7AF9C;
            --ink-faint: #857D6C;
            --line: #37342A;
            --teal: #4FD8DD;
            --gold: #E6BA76;
            --seal: #FF7A6B;
            --panel: #201D16;
            --panel-2: #29251C;
            --st-idea: #A79B87; --st-disenado: #B79FFF; --st-construyendo: #E6BA76;
            --st-activo: #8FE8BC; --st-finalizado: #4FD8DD; --st-pausado: #C7D3D8;
            --teal-glow: rgba(79,216,221,0.45); --tint-ok: rgba(143,232,188,0.08); --tint-warn: rgba(230,186,118,0.1); --badge-ink: #15130E;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background-color: var(--bg);
            color: var(--ink);
            font-family: "EB Garamond", serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .paper-overlay {
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image:
                url("https://www.transparenttextures.com/patterns/natural-paper.png"),
                url("https://www.transparenttextures.com/patterns/natural-paper.png");
            background-position: 0px 0px, 40px 60px;
            background-repeat: repeat;
        }
        html.theme-dark .paper-overlay { filter: invert(1) grayscale(1) brightness(1.7); mix-blend-mode: screen; opacity: 0.5; }
        .topbar, .wrap { position: relative; z-index: 1; }

        /* ── topbar ── */
        .topbar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 1.1rem 2rem; border-bottom: 1px solid var(--line);
        }
        .topbar-right { display: flex; align-items: center; gap: 1.1rem; }
        .theme-toggle {
            display: inline-flex; align-items: center; justify-content: center;
            width: 30px; height: 30px; border-radius: 50%;
            border: 1px solid var(--line); background: var(--panel); color: var(--ink);
            cursor: pointer; font-size: 0.9rem; line-height: 1; padding: 0;
            transition: border-color 0.2s ease, transform 0.2s ease;
        }
        .theme-toggle:hover { border-color: var(--teal); transform: translateY(-1px); }
        .brand {
            display: flex; align-items: baseline; gap: 0.6rem; text-decoration: none;
            font-family: "Reenie Beanie", cursive; font-size: 1.6rem; color: var(--ink);
        }
        .brand small {
            font-family: "Inter", sans-serif; font-size: 0.62rem; letter-spacing: 0.16em;
            text-transform: uppercase; color: var(--ink-soft);
        }
        .crumbs { font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
        .crumbs a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--line); }
        .crumbs a:hover { color: var(--teal); border-color: var(--teal); }
        .crumbs .current { color: var(--ink); }

        .wrap { max-width: 1040px; margin: 0 auto; padding: 0 1.5rem; }

        /* ── hero ── */
        .hero { padding: 3.5rem 0 2.5rem; }
        .kicker {
            font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.22em;
            text-transform: uppercase; color: var(--gold); margin-bottom: 0.9rem;
        }
        .hero h1 {
            font-size: clamp(2.3rem, 5.5vw, 3.6rem); font-weight: 500; line-height: 1.05;
            letter-spacing: -0.01em; margin: 0 0 0.7rem;
        }
        .hero .lede {
            font-style: italic; color: var(--ink-soft); font-size: 1.2rem;
            max-width: 58ch; margin: 0 0 1.6rem; line-height: 1.5;
        }
        .hero-cta {
            display: inline-flex; align-items: center; gap: 0.5rem;
            font-family: "Inter", sans-serif; font-size: 0.8rem; text-decoration: none;
            color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px;
        }
        .hero-cta:hover { color: var(--teal); border-color: var(--teal); }

        /* ── stat strip ── */
        .stats {
            display: grid; grid-template-columns: repeat(5, 1fr);
            border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 2.5rem 0;
        }
        @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } .stat { border-top: 1px solid var(--line); } }
        .stat { padding: 1.4rem 1rem; text-align: center; border-left: 1px solid var(--line); }
        .stat:first-child { border-left: none; }
        .stat b {
            display: block; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 600;
            color: var(--teal); line-height: 1; margin-bottom: 0.4rem;
            text-shadow: 0 0 16px var(--teal-glow);
        }
        .stat span {
            font-family: "Inter", sans-serif; font-size: 0.68rem; letter-spacing: 0.05em;
            color: var(--ink-soft); line-height: 1.3; display: block;
        }

        /* ── section heading ── */
        .section-head {
            display: flex; align-items: baseline; justify-content: space-between;
            gap: 1rem; margin: 4rem 0 1.5rem;
        }
        .section-head h2 { font-size: 1.5rem; font-weight: 500; margin: 0; }
        .section-head .num {
            font-family: "JetBrains Mono", monospace; font-size: 0.7rem;
            color: var(--gold); letter-spacing: 0.05em; white-space: nowrap;
        }
        .section-note {
            font-family: "Inter", sans-serif; font-size: 0.82rem; color: var(--ink-soft);
            margin: -0.8rem 0 1.6rem; max-width: 64ch; line-height: 1.55;
        }

        /* ── las tres capas de mutación ── */
        .mutlayers { display: flex; flex-direction: column; gap: 0.7rem; }
        .mutlayer {
            display: grid; grid-template-columns: 54px 1fr 1.1fr; align-items: center; gap: 1.2rem;
            text-decoration: none; color: var(--ink);
            background: var(--panel); border: 1px solid var(--line);
            border-left: 5px solid var(--c, var(--gold)); border-radius: 8px;
            padding: 1.1rem 1.4rem; transition: transform 0.2s ease;
        }
        .mutlayer:hover { transform: translateX(3px); }
        @media (max-width: 700px) { .mutlayer { grid-template-columns: 40px 1fr; } .mutlayer .ml-right { grid-column: 1 / -1; } }
        .ml-n { font-family: "JetBrains Mono", monospace; font-size: 1.3rem; color: var(--c); font-weight: 500; }
        .ml-name { font-size: 1.15rem; font-weight: 600; margin: 0 0 0.15rem; }
        .ml-sub {
            font-family: "Inter", sans-serif; font-size: 0.68rem; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--c);
        }
        .ml-right { font-family: "Inter", sans-serif; }
        .ml-q { font-size: 0.94rem; font-weight: 600; color: var(--ink); margin-bottom: 0.2rem; }
        .ml-donde { font-size: 0.78rem; color: var(--ink-soft); }

        /* ── regla dura ── */
        .rule {
            margin: 2rem 0 0; background: var(--panel-2);
            border: 1px solid var(--line); border-left: 5px solid var(--seal);
            border-radius: 8px; padding: 1.5rem 1.7rem;
        }
        .rule-label {
            font-family: "Inter", sans-serif; font-size: 0.64rem; letter-spacing: 0.14em;
            text-transform: uppercase; color: var(--seal); font-weight: 700; margin-bottom: 0.6rem;
        }
        .rule p { margin: 0; font-size: 1.28rem; line-height: 1.4; font-weight: 500; }
        .rule .why {
            font-family: "Inter", sans-serif; font-size: 0.8rem; color: var(--ink-soft);
            margin: 0.8rem 0 0; line-height: 1.55; font-weight: 400;
        }

        /* ── cards de categorías ── */
        .chambers { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
        @media (max-width: 640px) { .chambers { grid-template-columns: 1fr; } }
        .chamber {
            display: block; text-decoration: none; color: var(--ink);
            background: var(--panel); border: 1px solid var(--line);
            border-left: 4px solid var(--c, var(--gold)); border-radius: 8px;
            padding: 1.3rem 1.5rem; transition: transform 0.2s ease;
        }
        .chamber:hover { transform: translateX(3px); }
        .chamber-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; }
        .chamber-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c, var(--gold)); flex-shrink: 0; }
        .chamber-n { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; color: var(--ink-faint); }
        .chamber h3 { font-size: 1.15rem; font-weight: 600; margin: 0 0 0.15rem; }
        .chamber .sub {
            font-family: "Inter", sans-serif; font-size: 0.7rem; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--c, var(--gold)); margin-bottom: 0.6rem;
        }
        .chamber p { font-family: "Inter", sans-serif; font-size: 0.86rem; line-height: 1.5; color: var(--ink-soft); margin: 0; }
        .chamber.is-cold { opacity: 0.6; }

        /* ── clusters de áreas ── */
        .cluster { margin-bottom: 2rem; }
        .cluster-head {
            display: flex; align-items: center; gap: 0.5rem; font-family: "Inter", sans-serif;
            font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
            color: var(--ink-soft); margin-bottom: 0.8rem; text-decoration: none;
        }
        .cluster-head:hover { color: var(--teal); }
        .cluster-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .cluster-count { font-family: "JetBrains Mono", monospace; color: var(--ink-faint); }
        .area-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 0.7rem; }
        .area-card {
            display: block; text-decoration: none; color: var(--ink);
            background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
            padding: 0.9rem 1.05rem; transition: border-color 0.2s ease, transform 0.2s ease;
        }
        .area-card:hover { border-color: var(--c, var(--gold)); transform: translateY(-2px); }
        .area-card h4 {
            font-family: "JetBrains Mono", monospace; font-size: 0.84rem; font-weight: 500;
            margin: 0 0 0.35rem; color: var(--c, var(--gold));
        }
        .area-card p { font-family: "Inter", sans-serif; font-size: 0.76rem; line-height: 1.45; color: var(--ink-soft); margin: 0; }

        /* ── brechas ── */
        .gaps {
            display: flex; flex-direction: column; gap: 0.55rem;
            background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem;
        }
        .gap {
            display: grid; grid-template-columns: 46px 1fr 150px 90px; align-items: center;
            gap: 1rem; text-decoration: none; color: var(--ink); padding: 0.45rem 0.4rem;
            border-radius: 6px; transition: background 0.2s ease;
        }
        .gap:hover { background: var(--panel-2); }
        @media (max-width: 760px) {
            .gap { grid-template-columns: 40px 1fr 70px; }
            .gap .gap-bar { grid-column: 2 / -1; }
        }
        .gap-n { font-family: "JetBrains Mono", monospace; font-size: 0.7rem; color: var(--ink-faint); }
        .gap-txt h4 { font-size: 0.95rem; font-weight: 600; margin: 0 0 0.1rem; }
        .gap-txt p { font-family: "Inter", sans-serif; font-size: 0.76rem; color: var(--ink-soft); margin: 0; line-height: 1.4; }
        .gap-bar { height: 9px; background: var(--panel-2); border-radius: 6px; overflow: hidden; }
        .gap-bar i { display: block; height: 100%; border-radius: 6px; }
        .gap-sev {
            font-family: "Inter", sans-serif; font-size: 0.64rem; letter-spacing: 0.05em;
            text-transform: uppercase; text-align: right; white-space: nowrap;
        }

        /* ── test de colecciones ── */
        .test { display: flex; flex-direction: column; gap: 0.5rem; }
        .test-row {
            display: grid; grid-template-columns: 170px 74px 1fr; align-items: center; gap: 1rem;
            background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 0.7rem 1.05rem;
        }
        @media (max-width: 620px) { .test-row { grid-template-columns: 1fr 74px; } .test-row .test-why { grid-column: 1 / -1; } }
        .test-name { font-family: "JetBrains Mono", monospace; font-size: 0.82rem; }
        .test-verdict {
            font-family: "Inter", sans-serif; font-size: 0.62rem; font-weight: 700;
            letter-spacing: 0.06em; text-transform: uppercase; text-align: center;
            padding: 0.2rem 0.35rem; border-radius: 4px;
        }
        .test-verdict.yes { color: var(--st-activo); background: var(--tint-ok); }
        .test-verdict.no { color: var(--ink-faint); background: var(--panel-2); }
        .test-why { font-family: "Inter", sans-serif; font-size: 0.78rem; color: var(--ink-soft); line-height: 1.4; }

        /* ── vocabulario ── */
        .vocab { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.7rem; }
        .vword {
            display: block; text-decoration: none; color: var(--ink); background: var(--panel);
            border: 1px solid var(--line); border-top: 3px solid var(--teal); border-radius: 8px;
            padding: 0.95rem 1.1rem; transition: transform 0.2s ease;
        }
        .vword:hover { transform: translateY(-2px); }
        .vword b { font-family: "JetBrains Mono", monospace; font-size: 0.86rem; display: block; margin-bottom: 0.35rem; color: var(--teal); }
        .vword span { font-family: "Inter", sans-serif; font-size: 0.77rem; color: var(--ink-soft); line-height: 1.45; }

        /* ── bucles ── */
        .loops { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.7rem; }
        .loop {
            display: block; text-decoration: none; color: var(--ink); background: var(--panel);
            border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: 8px;
            padding: 1rem 1.15rem; transition: transform 0.2s ease;
        }
        .loop:hover { transform: translateX(3px); }
        .loop-top { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.4rem; }
        .loop-id { font-family: "JetBrains Mono", monospace; font-size: 0.9rem; font-weight: 600; color: var(--c); }
        .loop-kind {
            font-family: "Inter", sans-serif; font-size: 0.6rem; letter-spacing: 0.07em;
            text-transform: uppercase; color: var(--ink-faint);
        }
        .loop h4 { font-size: 0.98rem; font-weight: 600; margin: 0 0 0.3rem; }
        .loop p { font-family: "Inter", sans-serif; font-size: 0.77rem; color: var(--ink-soft); margin: 0 0 0.5rem; line-height: 1.45; }
        .loop-do {
            font-family: "Inter", sans-serif; font-size: 0.64rem; letter-spacing: 0.05em;
            text-transform: uppercase; color: var(--c); font-weight: 700;
        }

        /* ── escalera ── */
        .ladder { display: flex; flex-direction: column-reverse; gap: 0.5rem; }
        .rung {
            display: grid; grid-template-columns: 190px 1fr auto; align-items: center; gap: 1rem;
            padding: 0.65rem 1rem; border-radius: 6px; background: var(--panel); border: 1px solid var(--line);
        }
        @media (max-width: 700px) { .rung { grid-template-columns: 1fr auto; } .rung .rung-tag { grid-column: 1 / -1; } }
        .rung.hot { background: var(--tint-warn); border-color: var(--gold); }
        .rung-level { font-weight: 600; font-size: 0.92rem; }
        .rung-tag { font-family: "Inter", sans-serif; font-size: 0.76rem; color: var(--ink-soft); }
        .rung-tier {
            font-family: "Inter", sans-serif; font-size: 0.62rem; letter-spacing: 0.06em;
            text-transform: uppercase; color: var(--ink-faint); white-space: nowrap;
        }
        .rung.hot .rung-tier { color: var(--gold); font-weight: 600; }

        /* ── etapas ── */
        .roadmap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
        @media (max-width: 860px) { .roadmap { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 480px) { .roadmap { grid-template-columns: 1fr; } }
        .phase {
            display: block; text-decoration: none; color: var(--ink); background: var(--panel);
            border: 1px solid var(--line); border-radius: 8px; padding: 1.1rem 1.1rem 1.2rem; position: relative;
        }
        .phase:hover { border-color: var(--teal); }
        .phase.hecha { background: var(--tint-ok); border-color: var(--st-activo); }
        .phase.proxima { background: var(--tint-warn); border-color: var(--gold); }
        .phase-badge.hechabadge { background: var(--st-activo); color: var(--badge-ink); }
        .phase-badge.next { background: var(--teal); color: var(--badge-ink); }
        .phase-badge {
            position: absolute; top: -9px; right: 10px; font-family: "Inter", sans-serif;
            font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
            background: var(--gold); color: var(--badge-ink); padding: 0.15rem 0.45rem; border-radius: 3px;
        }
        .phase-n { font-family: "Inter", sans-serif; font-weight: 700; font-size: 0.85rem; color: var(--teal); margin-bottom: 0.1rem; }
        .phase-name { font-size: 1.02rem; font-weight: 600; margin-bottom: 0.15rem; }
        .phase-t { font-family: "Inter", sans-serif; font-size: 0.68rem; color: var(--ink-faint); margin-bottom: 0.8rem; }
        .phase ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
        .phase li {
            font-family: "Inter", sans-serif; font-size: 0.75rem; color: var(--ink-soft);
            line-height: 1.35; padding-left: 0.8rem; position: relative;
        }
        .phase li::before {
            content: ''; position: absolute; left: 0; top: 0.5em;
            width: 4px; height: 4px; border-radius: 50%; background: var(--gold);
        }

        /* ── camino crítico ── */
        .critical {
            font-family: "JetBrains Mono", monospace; font-size: 0.76rem; line-height: 1.75;
            background: var(--panel-2); border: 1px solid var(--line); border-radius: 8px;
            padding: 1.3rem 1.5rem; margin-top: 1.2rem; overflow-x: auto; white-space: pre;
            color: var(--ink-soft);
        }

        /* ── decisiones ── */
        .decs { display: flex; flex-direction: column; gap: 0.55rem; }
        .dec {
            display: grid; grid-template-columns: 30px 1fr 1.4fr 96px; align-items: center; gap: 1rem;
            background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 0.8rem 1.05rem;
        }
        @media (max-width: 760px) { .dec { grid-template-columns: 30px 1fr 92px; } .dec .dec-rec { grid-column: 2 / -1; } }
        .dec.needs { border-left: 4px solid var(--seal); }
        .dec-n { font-family: "JetBrains Mono", monospace; font-size: 0.8rem; color: var(--ink-faint); }
        .dec-q { font-size: 0.95rem; font-weight: 600; }
        .dec-rec { font-family: "Inter", sans-serif; font-size: 0.78rem; color: var(--ink-soft); line-height: 1.4; }
        .dec-badge {
            font-family: "Inter", sans-serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em;
            text-transform: uppercase; text-align: center; padding: 0.22rem 0.35rem; border-radius: 4px;
        }
        .dec-badge.asum { color: var(--ink-faint); background: var(--panel-2); }
        .dec-badge.tuya { color: var(--badge-ink); background: var(--seal); }

        /* ── fallas ── */
        .risks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
        @media (max-width: 700px) { .risks { grid-template-columns: 1fr 1fr; } }
        @media (max-width: 460px) { .risks { grid-template-columns: 1fr; } }
        .risk {
            background: var(--panel); border: 1px solid var(--line);
            border-left: 3px solid var(--seal); border-radius: 6px; padding: 0.9rem 1.05rem;
        }
        .risk h4 { font-size: 0.9rem; font-weight: 600; margin: 0 0 0.25rem; }
        .risk p { font-family: "Inter", sans-serif; font-size: 0.76rem; color: var(--ink-soft); margin: 0; line-height: 1.4; }

        /* ── footer nav ── */
        .footnav {
            margin: 5rem 0 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem;
            font-family: "Inter", sans-serif; font-size: 0.8rem;
        }
        .footnav a { text-decoration: none; color: var(--ink-soft); }
        .footnav a:hover { color: var(--teal); }
        .footnav .primary { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px; }
        .footnav .primary:hover { color: var(--teal); border-color: var(--teal); }
    </style>
</head>
<body>
    <div class="paper-overlay" aria-hidden="true"></div>
    <div class="topbar">
        <a href="/astro-project-v2/kx/" class="brand">& <small>kx system</small></a>
        <div class="topbar-right">
            <nav class="crumbs">
                <a href="/astro-project-v2/">interlynkx</a> / <a href="/astro-project-v2/kx/">kx</a> / <span class="current">kx core · mapa</span>
            </nav>
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema">🌙</button>
        </div>
    </div>

    <div class="wrap">
        <section class="hero">
            <div class="kicker">kx core module · vista visual</div>
            <h1>El andamio, de un vistazo</h1>
            <p class="lede">
                Las tres categorías como tres preguntas, las tres capas de mutación que evitan
                que el sistema se duplique, y las ocho etapas en el orden en que se construye.
                Las decisiones ya están resueltas y las tres primeras etapas, ejecutadas.
            </p>
            <a class="hero-cta" href={DOC}>leer el plan completo &rarr;</a>
        </section>

        <div class="stats">
            <div class="stat"><b>3</b><span>categorías, como preguntas</span></div>
            <div class="stat"><b>3</b><span>capas de mutación</span></div>
            <div class="stat"><b>11</b><span>áreas de estructura</span></div>
            <div class="stat"><b>6</b><span>decisiones, todas resueltas</span></div>
            <div class="stat"><b>8</b><span>etapas, tres ya hechas</span></div>
        </div>

        <div class="section-head">
            <h2>Las tres capas de mutación</h2>
            <span class="num">§1.1</span>
        </div>
        <p class="section-note">
            La duplicación no se evita separando temas, se evita separando <b>cómo cambia cada cosa</b>.
            Un mismo hecho no puede vivir en dos capas: si se sobrescribe, es estado; si se acumula, es evento; si explica, es prosa.
        </p>
        <div class="mutlayers">
            {capas.map((c) => (
                <a class="mutlayer" href={c.href} style={`--c: ${c.color}`}>
                    <span class="ml-n">{c.n}</span>
                    <div>
                        <h3 class="ml-name">{c.name}</h3>
                        <div class="ml-sub">{c.sub}</div>
                    </div>
                    <div class="ml-right">
                        <div class="ml-q">{c.q}</div>
                        <div class="ml-donde">{c.donde}</div>
                    </div>
                </a>
            ))}
        </div>

        <div class="rule">
            <div class="rule-label">la regla dura · §1.2</div>
            <p>La prosa nunca enuncia inventario. El inventario siempre se renderiza.</p>
            <p class="why">
                Un archivo de área puede decir cómo se nombran las skills. No puede decir cuántas hay ni cuáles.
                Es la regla que decide si en tres meses la metaestructura te sirve o te miente, y el costo de que
                mienta no es solo tuyo: Claude también la lee.
            </p>
        </div>

        <div class="section-head">
            <h2>Las categorías, como preguntas</h2>
            <span class="num">§1</span>
        </div>
        <p class="section-note">
            Leídas como temas, hay que preguntar dónde va cada cosa nueva. Leídas como preguntas, el criterio
            se vuelve automático y deja de vivir en tu cabeza. Quedaron tres: la cuarta candidata
            (conocimiento técnico) se fue afuera del módulo, porque es materia prima que el sistema procesa,
            no algo que el sistema necesite para operarse.
        </p>
        <div class="chambers">
            {categorias.map((c) => (
                <a class={`chamber${c.n === '--' ? ' is-cold' : ''}`} href={c.href} style={`--c: ${c.color}`}>
                    <div class="chamber-top">
                        <span class="chamber-dot"></span>
                        <span class="chamber-n">{c.n}</span>
                    </div>
                    <h3>{c.name}</h3>
                    <div class="sub">{c.sub}</div>
                    <p>{c.line}</p>
                </a>
            ))}
        </div>

        <div class="section-head">
            <h2>Las áreas</h2>
            <span class="num">§3.1 · §3.6 · §3.7</span>
        </div>
        <p class="section-note">
            Once en Estructura (instancias y flujos separados, templates absorbidos, "raw materials" convertido
            en un campo), tres en Obra (pendientes es una vista de tareas, no un store), seis en Contexto.
        </p>
        {areas.map((cl) => (
            <div class="cluster">
                <a class="cluster-head" href={cl.href}>
                    <span class="cluster-dot" style={`background: ${cl.color}`}></span>
                    {cl.label}
                    <span class="cluster-count">{cl.items.length}</span>
                </a>
                <div class="area-grid">
                    {cl.items.map((it) => (
                        <a class="area-card" href={cl.href} style={`--c: ${cl.color}`}>
                            <h4>{it.title}</h4>
                            <p>{it.hook}</p>
                        </a>
                    ))}
                </div>
            </div>
        ))}

        <div class="section-head">
            <h2>Las siete brechas, por peso</h2>
            <span class="num">§2</span>
        </div>
        <p class="section-note">
            No hipótesis: esto salió de leer el sistema como estaba. <b>Tres ya están cerradas</b> y van al final.
            Las dos primeras de las abiertas son las que justifican el orden de lo que queda.
        </p>
        <div class="gaps">
            {brechas.map((b) => (
                <a class="gap" href={b.href}>
                    <span class="gap-n">§{b.n}</span>
                    <div class="gap-txt">
                        <h4>{b.title}</h4>
                        <p>{b.hook}</p>
                    </div>
                    <div class="gap-bar">
                        <i style={`width: ${b.cerrada ? 100 : b.peso}%; background: ${b.cerrada ? 'var(--st-activo)' : b.peso > 85 ? 'var(--seal)' : b.peso > 60 ? 'var(--gold)' : 'var(--st-pausado)'}`}></i>
                    </div>
                    <span class="gap-sev" style={`color: ${b.cerrada ? 'var(--st-activo)' : b.peso > 85 ? 'var(--seal)' : b.peso > 60 ? 'var(--gold)' : 'var(--ink-faint)'}`}>{b.sev}</span>
                </a>
            ))}
        </div>

        <div class="section-head">
            <h2>El test de colecciones</h2>
            <span class="num">§2.6</span>
        </div>
        <p class="section-note">
            ¿Esta colección responde una pregunta que hoy no se puede responder de ninguna forma?
            Siete candidatas, dos pasan. Es la barrera contra el sprawl que ya empezó.
        </p>
        <div class="test">
            {test.map((t) => (
                <div class="test-row">
                    <span class="test-name">{t.name}</span>
                    <span class={`test-verdict ${t.pasa ? 'yes' : 'no'}`}>{t.pasa ? 'pasa' : 'no pasa'}</span>
                    <span class="test-why">{t.razon}</span>
                </div>
            ))}
        </div>

        <div class="section-head">
            <h2>El vocabulario nuevo</h2>
            <span class="num">§3</span>
        </div>
        <p class="section-note">
            Cinco términos, y ninguno agrega un campo al momento de dictar. Todo se llena al destilar o al publicar.
        </p>
        <div class="vocab">
            {vocab.map((v) => (
                <a class="vword" href={v.href}>
                    <b>{v.t}</b>
                    <span>{v.d}</span>
                </a>
            ))}
        </div>

        <div class="section-head">
            <h2>Los bucles que deciden si esto vive</h2>
            <span class="num">§4</span>
        </div>
        <p class="section-note">
            Dos hay que alimentar y dos hay que cortar de entrada. El R2 es el que mata metaestructuras,
            y mata más rápido a las buenas que a las malas.
        </p>
        <div class="loops">
            {bucles.map((b) => (
                <a class="loop" href={b.href} style={`--c: ${b.color}`}>
                    <div class="loop-top">
                        <span class="loop-id">{b.id}</span>
                        <span class="loop-kind">{b.kind}</span>
                    </div>
                    <h4>{b.title}</h4>
                    <p>{b.line}</p>
                    <div class="loop-do">{b.accion}</div>
                </a>
            ))}
        </div>

        <div class="section-head">
            <h2>Puntos de apalancamiento</h2>
            <span class="num">§5</span>
        </div>
        <p class="section-note">
            De abajo hacia arriba. Lo contraintuitivo: la intervención más potente no es automatizar el
            destilado, es cambiar qué tenés en la pantalla en el momento de hablar.
        </p>
        <div class="ladder">
            {leverage.map((l) => (
                <div class={`rung${l.hot ? ' hot' : ''}`}>
                    <span class="rung-level">{l.level}</span>
                    <span class="rung-tag">{l.tag}</span>
                    <span class="rung-tier">{l.tier}</span>
                </div>
            ))}
        </div>

        <div class="section-head">
            <h2>Las ocho etapas</h2>
            <span class="num">§6</span>
        </div>
        <p class="section-note">
            Cada una deja algo usable aunque las siguientes nunca se hagan. A, B y C están hechas: el vocabulario,
            la tabla de ruteo y el log. La D es la próxima, y es la que habilita "quiero seguir con skills".
        </p>
        <div class="roadmap">
            {etapas.map((e) => (
                <a class={`phase${e.hecha ? ' hecha' : ''}${e.proxima ? ' proxima' : ''}`} href={e.href}>
                    {e.hecha && <span class="phase-badge hechabadge">hecha</span>}
                    {e.proxima && <span class="phase-badge next">próxima</span>}
                    <div class="phase-n">Etapa {e.fase}</div>
                    <div class="phase-name">{e.nombre}</div>
                    <div class="phase-t">{e.tiempo}</div>
                    <ul>
                        {e.items.map((it) => <li>{it}</li>)}
                    </ul>
                </a>
            ))}
        </div>
        <a href={`${DOC}#el-camino-crítico`} style="text-decoration: none;">
            <div class="critical">{`A (vocabulario) ──▶ B (ruteo, CLAUDE.md del módulo)
                      │
                      ├──▶ C (eventos) ──▶ D (área) ──▶ G (sesiones) ──▶ H (organigrama)
                      ├──▶ E (flujos)          ← independiente
                      └──▶ F (árbol)           ← independiente`}</div>
        </a>

        <div class="section-head">
            <h2>Decisiones</h2>
            <span class="num">§7</span>
        </div>
        <p class="section-note">
            Las seis se cerraron en KX-S02. Marcadas en rojo las tres donde tu decisión fue distinta de lo que
            yo proponía, que son las que más vale la pena leer.
        </p>
        <div class="decs">
            {decisiones.map((d) => (
                <div class={`dec${d.asumida ? '' : ' needs'}`}>
                    <span class="dec-n">{d.n}</span>
                    <span class="dec-q">{d.q}</span>
                    <span class="dec-rec">{d.rec}</span>
                    <span class={`dec-badge ${d.asumida ? 'asum' : 'tuya'}`}>{d.asumida ? 'como propuse' : 'distinta'}</span>
                </div>
            ))}
        </div>

        <div class="section-head">
            <h2>Modos de falla</h2>
            <span class="num">§8</span>
        </div>
        <div class="risks">
            {fallas.map((f) => (
                <div class="risk">
                    <h4>{f.title}</h4>
                    <p>{f.line}</p>
                </div>
            ))}
        </div>

        <div class="footnav">
            <a href="/astro-project-v2/kx/">&larr; volver al hub</a>
            <a class="primary" href={DOC}>leer el plan completo &rarr;</a>
        </div>
    </div>
    <script is:inline>
        const themeToggle = document.getElementById('theme-toggle');
        function isDark() { return document.documentElement.classList.contains('theme-dark'); }
        function syncToggleIcon() { themeToggle.textContent = isDark() ? '☀' : '🌙'; }
        syncToggleIcon();
        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('theme-dark');
            try { localStorage.setItem('kx-theme', isDark() ? 'dark' : 'light'); } catch (e) {}
            syncToggleIcon();
        });
    </script>
</body>
</html>
