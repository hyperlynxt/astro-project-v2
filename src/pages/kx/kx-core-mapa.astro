  { fase: 'B', nombre: 'Ruteo', tiempo: 'hecha · 26.07.26', hecha: true, items: ['CLAUDE.md del módulo', 'esqueleto de carpetas', '11 + 6 archivos de área', 'documentos viejos deprecados'], href: `${DOC}#etapa-b--el-documento-de-ruteo--hecha-el-260726` },
