---
// Driver ontológico de las tareas: QUIÉN PUEDE DESBLOQUEARLA.
// Por eso van en columnas por tipo, en ese orden: primero lo que solo Teo
// puede resolver, último lo que es puro triage. No por estado, no por módulo.
import { getCollection } from 'astro:content';
import KxShell from '../../../layouts/KxShell.astro';
import Kicker from '../../../components/kx/Kicker.astro';
import Pastilla from '../../../components/kx/Pastilla.astro';
import BarraFiltros from '../../../components/kx/BarraFiltros.astro';
import Medidor from '../../../components/kx/Medidor.astro';
import { TIPO_TAREA_PASTILLA, fechaCorta, AREAS } from '../../../lib/kx';

const base = '/astro-project-v2';
const tareas = await getCollection('kxTareas');
const modulos = await getCollection('kxModulos');
const moduloTitulo = (id?: string) => modulos.find((m) => m.id === id)?.data.titulo ?? id ?? '';

// Quién la desbloquea, que es el criterio real de la taxonomía.
const QUIEN: Record<string, string> = {
  decidir: 'solo Teo',
  pensar: 'Teo y Claude juntos',
  construir: 'Claude, mayormente solo',
  escribir: 'Teo dictando',
  aclarar: 'Teo, es triage',
};
const ORDEN_TIPO = ['decidir', 'pensar', 'construir', 'escribir', 'aclarar'];

const abiertas = tareas.filter((t) => t.data.estado !== 'cerrada');
const cerradas = tareas.filter((t) => t.data.estado === 'cerrada');

const columnas = ORDEN_TIPO.map((tipo) => ({
  tipo,
  items: abiertas
    .filter((t) => t.data.tipo === tipo)
    .sort((a, b) => {
      const p = { alta: 0, media: 1, baja: 2 } as Record<string, number>;
      const pa = p[a.data.prioridad ?? 'media'] ?? 1;
      const pb = p[b.data.prioridad ?? 'media'] ?? 1;
      if (pa !== pb) return pa - pb;
      return a.data.id.localeCompare(b.data.id);
    }),
}));

const desglose = [
  { estado: 'abierta', count: abiertas.filter((t) => t.data.estado === 'abierta').length },
  { estado: 'bloqueada', count: abiertas.filter((t) => t.data.estado === 'bloqueada').length },
  { estado: 'cerrada', count: cerradas.length },
];

// Qué desbloquea cada tarea: el grafo de bloqueos, en las dos direcciones.
const desbloquea = (id: string) => tareas.filter((t) => t.data.bloqueadaPor?.includes(id));
const tituloDe = (id: string) => tareas.find((t) => t.data.id === id)?.data.titulo ?? id;

const areasConTareas = AREAS.filter((a) => tareas.some((t) => t.data.area === a.slug));
const grupos = [
  { key: 'estado', label: 'Estado', opciones: [
    { value: 'abierta', label: 'abierta' }, { value: 'bloqueada', label: 'bloqueada' },
  ]},
  { key: 'area', label: 'Área', opciones: areasConTareas.map((a) => ({ value: a.slug, label: a.label })) },
];
---

<KxShell title="Tareas" crumbs={[{ label: 'Autopoiesis', href: `${base}/kx/autopoiesis/` }, { label: 'Tareas' }]}>
  <Fragment slot="kicker"><Kicker texto="autopoiesis · tareas" color="lavender" /></Fragment>
  <h1 slot="title">Tareas</h1>
  <p class="kx-lede">
    Agrupadas por <strong>quién puede desbloquearlas</strong>, que es la pregunta útil cuando se mira
    el backlog un sábado. No por estado ni por módulo.
  </p>

  <div class="kx-medidor-row">
    <Medidor valor={tareas.length} label="tareas" desglose={desglose} rampa="estadoTarea" />
  </div>

  <BarraFiltros grupos={grupos} />

  <div class="kx-columnas">
    {columnas.map((col) => (
      <section class="kx-col" style={`--ccolor: var(${TIPO_TAREA_PASTILLA[col.tipo].var})`}>
        <header class="kx-col-head">
          <Pastilla rampa="tipoTarea" valor={col.tipo} />
          <span class="kx-col-count">{col.items.length}</span>
        </header>
        <p class="kx-col-quien">lo desbloquea: <strong>{QUIEN[col.tipo]}</strong></p>
        <div class="kx-col-items">
          {col.items.length === 0 ? (
            <p class="kx-col-vacio">Nada abierto de este tipo.</p>
          ) : col.items.map((t) => {
            const bloquea = desbloquea(t.data.id);
            return (
              <article
                class={`kx-tarea ${t.data.estado === 'bloqueada' ? 'is-bloqueada' : ''}`}
                data-kx-filter={JSON.stringify({ estado: t.data.estado, area: t.data.area ?? '' })}
              >
                <div class="kx-tarea-head">
                  <span class="kx-tarea-id">{t.data.id}</span>
                  {t.data.prioridad === 'alta' && <span class="kx-prio">alta</span>}
                </div>
                <h3>{t.data.titulo}</h3>
                {t.data.bloqueadaPor?.length && (
                  <p class="kx-arista kx-arista--entra">
                    bloqueada por {t.data.bloqueadaPor.map((b) => <span class="kx-ref">{b}</span>)}
                  </p>
                )}
                {bloquea.length > 0 && (
                  <p class="kx-arista kx-arista--sale">
                    bloquea a {bloquea.map((b) => <span class="kx-ref">{b.data.id}</span>)}
                  </p>
                )}
                <footer class="kx-tarea-foot">
                  {t.data.modulo && <span>{moduloTitulo(t.data.modulo)}</span>}
                  <span class="kx-fecha">{fechaCorta(t.data.actualizado)}</span>
                </footer>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <div class="kx-shead">
    <h2>Cerradas</h2>
    <span class="kx-shead-count">{cerradas.length}</span>
  </div>
  <p class="kx-snote">Lo que ya se resolvió. Se listan porque el título dice cómo se resolvió, que a veces no es como se había planteado.</p>
  <div class="kx-cerradas">
    {cerradas.sort((a, b) => b.data.actualizado.getTime() - a.data.actualizado.getTime()).map((t) => (
      <div class="kx-cerrada">
        <span class="kx-tarea-id">{t.data.id}</span>
        <span class="kx-cerrada-titulo">{t.data.titulo}</span>
        <span class="kx-fecha">{fechaCorta(t.data.actualizado)}</span>
      </div>
    ))}
  </div>
</KxShell>

<style>
  .kx-lede { font-family: var(--kx-font-sans); font-size: 1rem; line-height: 1.6; color: var(--kx-ink-soft); max-width: 64ch; margin: 0.9rem 0 0; }
  .kx-lede strong { color: var(--kx-ink); font-weight: 600; }
  .kx-medidor-row { margin: 1.8rem 0 1.6rem; max-width: 400px; }

  .kx-columnas { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.8rem; align-items: start; }
  @media (max-width: 1100px) { .kx-columnas { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) { .kx-columnas { grid-template-columns: 1fr; } }
  .kx-col { border-top: 3px solid var(--ccolor); padding-top: 0.9rem; }
  .kx-col-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.4rem; }
  .kx-col-count { font-family: var(--kx-font-mono); font-size: 0.72rem; color: var(--kx-ink-faint); }
  .kx-col-quien { font-family: var(--kx-font-sans); font-size: 0.66rem; color: var(--kx-ink-faint); margin: 0 0 0.9rem; }
  .kx-col-quien strong { color: var(--ccolor); font-weight: 700; }
  .kx-col-items { display: flex; flex-direction: column; gap: 0.6rem; }
  .kx-col-vacio { font-family: var(--kx-font-sans); font-size: 0.75rem; color: var(--kx-ink-faint); font-style: italic; margin: 0; }

  .kx-tarea {
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius);
    padding: 0.85rem 0.95rem; box-shadow: 0 1px 6px var(--kx-shadow);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .kx-tarea:hover { border-color: var(--ccolor); transform: translateY(-2px); }
  .kx-tarea.is-bloqueada { border-style: dashed; opacity: 0.82; }
  .kx-tarea-head { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; margin-bottom: 0.35rem; }
  .kx-tarea-id { font-family: var(--kx-font-mono); font-size: 0.64rem; color: var(--ccolor); font-weight: 600; }
  .kx-prio {
    font-family: var(--kx-font-sans); font-size: 0.56rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--kx-alert); background: var(--kx-alert-tint);
    padding: 0.12rem 0.38rem; border-radius: var(--kx-radius-pill);
  }
  .kx-tarea h3 { font-family: var(--kx-font-sans); font-size: 0.82rem; font-weight: 600; margin: 0 0 0.5rem; line-height: 1.4; }
  .kx-arista {
    font-family: var(--kx-font-sans); font-size: 0.64rem; margin: 0 0 0.35rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem;
  }
  .kx-arista--entra { color: var(--kx-alert); }
  .kx-arista--sale { color: var(--kx-ink-faint); }
  .kx-ref {
    font-family: var(--kx-font-mono); font-size: 0.6rem; font-weight: 600;
    background: var(--kx-panel); border: 1px solid var(--kx-line);
    padding: 0.08rem 0.32rem; border-radius: 4px; color: inherit;
  }
  .kx-tarea-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    margin-top: 0.6rem; padding-top: 0.5rem; border-top: 1px solid var(--kx-line-soft);
    font-family: var(--kx-font-sans); font-size: 0.62rem; color: var(--kx-ink-faint);
  }
  .kx-fecha { font-family: var(--kx-font-mono); font-size: 0.6rem; color: var(--kx-ink-faint); white-space: nowrap; }

  .kx-shead { display: flex; align-items: baseline; gap: 0.8rem; margin: 3rem 0 0.3rem; }
  .kx-shead h2 { font-size: 1.3rem; font-weight: 500; margin: 0; }
  .kx-shead-count { font-family: var(--kx-font-mono); font-size: 0.72rem; color: var(--kx-mint-deep); background: var(--kx-mint-tint); padding: 0.15rem 0.5rem; border-radius: var(--kx-radius-pill); }
  .kx-snote { font-family: var(--kx-font-sans); font-size: 0.85rem; color: var(--kx-ink-soft); margin: 0.4rem 0 1.2rem; max-width: 64ch; }
  .kx-cerradas {
    background: var(--kx-paper); border: 1px solid var(--kx-line); border-radius: var(--kx-radius-lg);
    padding: 0.2rem 1.3rem; box-shadow: 0 2px 10px var(--kx-shadow);
  }
  .kx-cerrada {
    display: flex; align-items: baseline; gap: 0.8rem; padding: 0.6rem 0;
    border-top: 1px solid var(--kx-line-soft); font-family: var(--kx-font-sans); font-size: 0.8rem;
  }
  .kx-cerrada:first-child { border-top: none; }
  .kx-cerrada .kx-tarea-id { color: var(--kx-mint-deep); flex-shrink: 0; }
  .kx-cerrada-titulo { color: var(--kx-ink-soft); flex: 1; }
</style>
