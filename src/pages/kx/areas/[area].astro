---
import { getCollection } from 'astro:content';
import {
  AREAS,
  AREA_DE_TIPO_PIEZA,
  AREA_ARCHIVO_BOVEDA,
  ACTUAL_ESTADOS,
  VISION_ESTADOS,
  fechaCorta,
} from '../../../lib/kx';

export function getStaticPaths() {
  return AREAS.map((a) => ({ params: { area: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;

const piezas = await getCollection('kxPiezas');
const piezasArea = piezas
  .filter((p) => AREA_DE_TIPO_PIEZA[p.data.tipo] === area.slug)
  .sort((a, b) => b.data.actualizado.getTime() - a.data.actualizado.getTime());

const piezasActual = piezasArea.filter((p) => ACTUAL_ESTADOS.includes(p.data.estado));
const piezasVision = piezasArea.filter((p) => VISION_ESTADOS.includes(p.data.estado));

const seMovioUltimo = [...piezasArea].slice(0, 5);

const archivoBoveda = AREA_ARCHIVO_BOVEDA[area.slug];

const ESTADO_LABEL: Record<string, string> = {
  idea: 'idea', disenado: 'diseñado', construyendo: 'construyendo',
  activo: 'live', finalizado: 'finalizado', pausado: 'pausado', deprecado: 'deprecado',
};
const ESTADO_COLOR: Record<string, string> = {
  idea: '#A39985', disenado: '#7C6FC4', construyendo: '#C6862E',
  activo: '#2F8F94', finalizado: '#1F6367', pausado: '#B8657A', deprecado: '#A39985',
};
---

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{area.label} · kx atlas system</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Reenie+Beanie&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #26241F; --ink-soft: #6B6459; --ink-faint: #A39985;
            --paper: #FFFFFF; --cream: #FDFCF9; --line: #ECE7DC; --line-soft: #F2EEE4;
            --teal: #2F8F94; --teal-deep: #1F6367; --teal-tint: #E9F7F7; --teal-mid: #BFE9EA;
            --gold: #B08D57;
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0; background: var(--cream); color: var(--ink);
            font-family: "EB Garamond", serif;
            -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
        }
        a { color: inherit; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(38,36,31,0.12); border-radius: 10px; }

        .nav {
            position: sticky; top: 0; z-index: 40;
            display: flex; align-items: center; justify-content: space-between;
            height: 78px; padding: 0 2.2rem;
            background: rgba(253,252,249,0.82);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--line);
        }
        .nav-left { display: flex; align-items: center; gap: 1.2rem; }
        .nav-brand {
            font-family: "Inter", sans-serif; font-weight: 800; font-size: 0.98rem;
            letter-spacing: -0.01em; text-decoration: none; color: var(--ink);
            display: flex; align-items: center; gap: 0.5rem;
        }
        .nav-brand .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 10px rgba(47,143,148,0.55); }
        .crumb { font-family: "Inter", sans-serif; font-size: 0.82rem; color: var(--ink-faint); }
        .crumb a { text-decoration: none; color: var(--ink-faint); transition: color 0.2s ease; }
        .crumb a:hover { color: var(--teal-deep); }
        .nav-right { font-family: "Reenie Beanie", cursive; font-size: 1.65rem; color: var(--teal); text-decoration: none; }

        .wrap { max-width: 900px; margin: 0 auto; padding: 0 1.6rem; }

        .hero { padding: 3.4rem 0 1.6rem; }
        .kicker { font-family: "Inter", sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.9rem; }
        .hero h1 { font-size: clamp(2.3rem, 5.5vw, 3.3rem); font-weight: 500; line-height: 1.05; margin: 0 0 0.8rem; }
        .hero .lede { font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft); margin: 0 0 1.1rem; max-width: 62ch; }
        .archivo {
            display: inline-flex; align-items: center; gap: 0.5rem;
            font-family: "Inter", sans-serif; font-size: 0.78rem; color: var(--ink-faint);
            background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem 0.9rem 0.4rem 0.7rem;
        }
        .archivo code { font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: var(--teal-deep); }

        .shead { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 3rem 0 0.3rem; }
        .shead h2 { font-size: 1.35rem; font-weight: 500; margin: 0; }
        .shead .tag {
            font-family: "Inter", sans-serif; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--teal); background: var(--teal-tint);
            padding: 0.28rem 0.65rem; border-radius: 999px;
        }
        .snote { font-family: "Inter", sans-serif; font-size: 0.85rem; color: var(--ink-soft); margin: 0.35rem 0 1.2rem; line-height: 1.5; }

        .rows { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: 0.2rem 1.5rem; box-shadow: 0 2px 10px rgba(38,36,31,0.045); }
        .rows-vision { opacity: 0.7; margin-top: 0.7rem; }
        .subhead { font-family: "Inter", sans-serif; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); margin: 1.3rem 0 0.5rem; }

        .prow { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.85rem 0; border-top: 1px solid var(--line-soft); }
        .prow:first-child { border-top: none; }
        .prow-left { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
        .prow-titulo { font-family: "Inter", sans-serif; font-weight: 600; font-size: 0.9rem; }
        .prow-tipo { font-family: "Inter", sans-serif; font-size: 0.7rem; color: var(--ink-faint); flex-shrink: 0; }
        .prow-right { display: flex; align-items: center; gap: 0.8rem; flex-shrink: 0; }
        .prow-fecha { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; color: var(--ink-faint); }
        .prow-chip { display: inline-flex; align-items: center; gap: 0.4rem; font-family: "Inter", sans-serif; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft); white-space: nowrap; }
        .prow-chip .dot { width: 6px; height: 6px; border-radius: 50%; }

        .nota-vacio {
            font-family: "Inter", sans-serif; font-size: 0.85rem; color: var(--ink-soft); line-height: 1.55;
            background: var(--paper); border: 1px dashed var(--line); border-radius: 16px; padding: 1.1rem 1.3rem;
        }
        .nota-vacio code { font-family: "JetBrains Mono", monospace; background: var(--teal-tint); color: var(--teal-deep); padding: 0.1rem 0.4rem; border-radius: 4px; }

        .footer {
            margin: 5rem 0 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem;
            font-family: "Inter", sans-serif; font-size: 0.8rem; color: var(--ink-faint);
        }
        .footer a { text-decoration: none; color: var(--ink-soft); font-weight: 600; }
        .footer a:hover { color: var(--teal-deep); }
    </style>
</head>
<body>
    <div class="nav">
        <div class="nav-left">
            <a href="/astro-project-v2/kx/" class="nav-brand"><span class="dot"></span>kx atlas system</a>
            <span class="crumb">/ <a href="/astro-project-v2/kx/areas/">áreas</a> / {area.label.toLowerCase()}</span>
        </div>
        <a href="/astro-project-v2/" class="nav-right">hyperlynxt | teo</a>
    </div>

    <div class="wrap">
        <section class="hero">
            <div class="kicker">01 · matriz</div>
            <h1>{area.label}</h1>
            <p class="lede">{area.linea}</p>
            <span class="archivo">Prosa y decisiones: <code>{archivoBoveda}</code></span>
        </section>

        {piezasArea.length > 0 ? (
            <>
                <div class="shead">
                    <h2>Piezas</h2>
                    <span class="tag">§1</span>
                </div>
                <p class="snote">Actual y visión, ordenadas por lo último que se tocó.</p>
                {piezasActual.length > 0 && (
                    <div class="rows">
                        {piezasActual.map((p) => (
                            <div class="prow">
                                <div class="prow-left">
                                    <span class="prow-titulo">{p.data.titulo}</span>
                                    <span class="prow-tipo">{p.data.tipo}</span>
                                </div>
                                <div class="prow-right">
                                    <span class="prow-fecha">{fechaCorta(p.data.actualizado)}</span>
                                    <span class="prow-chip"><span class="dot" style={`background: ${ESTADO_COLOR[p.data.estado] ?? '#A39985'}`}></span>{ESTADO_LABEL[p.data.estado] ?? p.data.estado}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
                {piezasVision.length > 0 && (
                    <>
                        <p class="subhead">visión</p>
                        <div class="rows rows-vision">
                            {piezasVision.map((p) => (
                                <div class="prow">
                                    <div class="prow-left">
                                        <span class="prow-titulo">{p.data.titulo}</span>
                                        <span class="prow-tipo">{p.data.tipo}</span>
                                    </div>
                                    <div class="prow-right">
                                        <span class="prow-fecha">{fechaCorta(p.data.actualizado)}</span>
                                        <span class="prow-chip"><span class="dot" style={`background: ${ESTADO_COLOR[p.data.estado] ?? '#A39985'}`}></span>{ESTADO_LABEL[p.data.estado] ?? p.data.estado}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </>
                )}
            </>
        ) : (
            <>
                <div class="shead">
                    <h2>Piezas</h2>
                    <span class="tag">§1</span>
                </div>
                <p class="nota-vacio">Esta área todavía no tiene piezas cargadas como objetos del sistema.</p>
            </>
        )}

        <div class="shead">
            <h2>Tareas</h2>
            <span class="tag">§2</span>
        </div>
        <p class="nota-vacio">
            Falta el campo <code>area</code> en <code>kx-tareas</code> (es la Etapa D del andamio del kx atlas system).
            Hasta que exista, las tareas no se pueden filtrar por área sin arriesgar resultados falsos.
        </p>

        {seMovioUltimo.length > 0 && (
            <>
                <div class="shead">
                    <h2>Se movió último</h2>
                    <span class="tag">§3</span>
                </div>
                <p class="snote">Las piezas de esta área ordenadas por su última actualización.</p>
                <div class="rows">
                    {seMovioUltimo.map((p) => (
                        <div class="prow">
                            <div class="prow-left">
                                <span class="prow-titulo">{p.data.titulo}</span>
                                <span class="prow-tipo">{p.data.tipo}</span>
                            </div>
                            <span class="prow-fecha">{fechaCorta(p.data.actualizado)}</span>
                        </div>
                    ))}
                </div>
            </>
        )}

        <div class="footer">
            <a href="/astro-project-v2/kx/areas/">&larr; todas las áreas</a>
            <a href="/astro-project-v2/kx/">volver al hub</a>
        </div>
    </div>
</body>
</html>
